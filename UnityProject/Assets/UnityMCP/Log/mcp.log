null);\n    var t = comp.GetType();\n    var doc = host.GetComponent<UnityEngine.UIElements.UIDocument>();\n    var root = doc.rootVisualElement;\n\n    var entryBtn = QButton(root, \"EntryToggleButton\");\n    ClickButton(entryBtn);\n    Check(\"panel opened via real click\", GameLogic.Stage.GameRoot.HomeValley.IsCraftStationPanelOpen, null);\n\n    var refreshAll = t.GetMethod(\"RefreshAll\", BF);\n    refreshAll.Invoke(comp, null);\n\n    var capLabel = QLabel(root, \"BagCapacityLabel\");\n    results.Add(\"INFO BagCapacityLabel=\" + capLabel.text);\n    Check(\"BagCapacityLabel real-renders\", capLabel.text.StartsWith(\"仓 \"), capLabel.text);\n\n    var upgradeA = QDropdown(root, \"UpgradeMaterialADropdown\");\n    var upgradeB = QDropdown(root, \"UpgradeMaterialBDropdown\");\n    results.Add(\"INFO upgradeA choices count=\" + upgradeA.choices.Count + \" first=\" + (upgradeA.choices.Count > 0 ? upgradeA.choices[0] : \"(none)\"));\n\n    if (upgradeA.choices.Count >= 2)\n    {\n        Check(\"Upgrade dropdown shows 聚焦镜 display name\", upgradeA.choices[0].Contains(\"聚焦镜\"), upgradeA.choices[0]);\n        upgradeA.index = 0;\n        upgradeB.index = 1;\n        ClickButton(QButton(root, \"EnqueueUpgradeButton\"));\n        refreshAll.Invoke(comp, null);\n        var resultLabel = QLabel(root, \"CraftResultLabel\");\n        results.Add(\"INFO CraftResultLabel after real enqueue upgrade click: '\" + resultLabel.text + \"'\");\n        Check(\"Real click Enqueue Upgrade succeeds (no failure text)\", string.IsNullOrEmpty(resultLabel.text), resultLabel.text);\n\n        var queueList = QScroll(root, \"QueueList\");\n        UnityEngine.UIElements.VisualElement firstRow = null;\n        foreach (var child in queueList.Children())\n        {\n            if (child.style.display == UnityEngine.UIElements.DisplayStyle.Flex) { firstRow = child; break; }\n        }\n        Check(\"found a visible queue row\", firstRow != null, null);\n        if (firstRow != null)\n      