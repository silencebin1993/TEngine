{"ts":"2026-09-22T13:38:25.527Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":506,"action":"execute","params":{"action":"execute","code":"\nvar ids = new System.Collections.Generic.List<string>(GameLogic.MetabolicSlice.ContentCatalog.GeneCatalog.AllModuleIds);\nids.Sort(System.StringComparer.Ordinal);\nvar sb = new System.Text.StringBuilder();\nforeach (var id in ids) {\n    var name = GameLogic.MetabolicSlice.ContentCatalog.GeneCatalog.GetDisplayName(id);\n    sb.AppendLine(id + \"|\" + name);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-22T13:42:54.721Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":591,"action":"execute","params":{"action":"execute","code":"\nvar sb = new System.Text.StringBuilder();\nGameLogic.MetabolicSlice.Carrier.CompiledRecipeCache.ResetForTest();\n\nvar engine = new ComposeEngine.Engine();\nComposeEngine.Builtin.Catalog.ReactionCatalog.RegisterDefaults(engine);\nvar world = new ComposeEngine.Core.WorldState();\n\n// 1) 固定输入事件指纹：org_emitter 无基因，seed=42，两次编译比较关键字段\nvar evts1 = GameLogic.MetabolicSlice.Carrier.CarrierCompiler.CompileFromRecipe(engine, \"org_emitter\", new System.Collections.Generic.List<string>(), world, 42);\nvar evts2 = GameLogic.MetabolicSlice.Carrier.CarrierCompiler.CompileFromRecipe(engine, \"org_emitter\", new System.Collections.Generic.List<string>(), world, 42);\nvar e1 = evts1[0]; var e2 = evts2[0];\nbool fingerprintStable = e1.Damage == e2.Damage && e1.Shape == e2.Shape && e1.Scale == e2.Scale && e1.Count == e2.Count;\nsb.AppendLine(\"FINGERPRINT_STABLE=\" + fingerprintStable + \" Damage=\" + e1.Damage + \" Shape=\" + e1.Shape);\n\n// 2) 静态配方缓存：同签名两次编译只 Build 一次；CompiledRecipe 引用相同\nint buildBefore = GameLogic.MetabolicSlice.Carrier.CompiledRecipeCache.BuildCount;\nvar evts3 = GameLogic.MetabolicSlice.Carrier.CarrierCompiler.CompileFromRecipe(engine, \"org_emitter\", new System.Collections.Generic.List<string>(), world, 99);\nint buildAfter = GameLogic.MetabolicSlice.Carrier.CompiledRecipeCache.BuildCount;\nsb.AppendLine(\"CACHE_HIT_NO_REBUILD=\" + (buildBefore == buildAfter) + \" BuildCount=\" + buildAfter);\n\n// 事件对象本身不是同一实例（动态相位不跨调用共享）\nbool eventInstancesDistinct = !object.ReferenceEquals(e1, e2);\nsb.AppendLine(\"EVENT_INSTANCES_DISTINCT=\" + eventInstancesDistinct);\n\n// 3) 模块实例隔离：同一 organelle 两次 CreateModule() 返回不同引用\nvar def = GameLogic.MetabolicSlice.ContentCatalog.OrganelleCatalog.Get(\"org_emitter\");\nvar m1 = def.CreateModule();\nvar m2 = def.CreateModule();\nsb.AppendLine(\"MODULE_INSTANCES_DISTINCT=\" + !object.ReferenceEquals(m1, m2));\n\n// 4) 已退役内容不能进入正式战斗链：org_taxis（IsRetired=true, AttackMethod=false）编译应返回空事件\nvar retiredEvts = GameLogic.MetabolicSlice.Carrier.CarrierCompiler.CompileFromRecipe(engine, \"org_taxis\", new System.Collections.Generic.List<string>(), world, 1);\nsb.AppendLine(\"RETIRED_BLOCKED=\" + (retiredEvts.Count == 0));\n\n// 5) 机械 Facade 新指纹：3 个 Locked-demo 组件用固定输入验证 Facade legacy id 能编译出真实事件\nvar lensEvts = GameLogic.MetabolicSlice.Carrier.CarrierCompiler.CompileFromRecipe(engine, \"org_lensbeam\", new System.Collections.Generic.List<string> { \"gene_taxis\" }, world, 7);\nsb.AppendLine(\"LENSBEAM_WITH_HOMING_EVENTS=\" + lensEvts.Count + \" Damage=\" + (lensEvts.Count > 0 ? lensEvts[0].Damage.ToString() : \"-\"));\n\n// 6) ComposeEngine 反应真实注册进正式引擎同款 catalog（与 MetabolicSliceBridge.cs:694 相同调用）：固定 Tag 输入验证反应触发\nvar reactEngine = new ComposeEngine.Engine();\nComposeEngine.Builtin.Catalog.ReactionCatalog.RegisterDefaults(reactEngine);\nvar testEvt = new ComposeEngine.Core.HitEvent();\ntestEvt.Tags.Add(\"Fire\"); testEvt.Tags.Add(\"Wet\"); testEvt.Damage = 10f;\nvar matched = new System.Collections.Generic.List<string>();\nforeach (var rule in reactEngine.Reactions.Match(testEvt.Tags)) matched.Add(rule.Id);\nsb.AppendLine(\"REACTION_MATCH_FOR_FireWet=\" + string.Join(\",\", matched));\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-22T13:46:16.337Z","tool":"execute_code","type":"tool","status":"ERROR","ms":563,"action":"execute","params":{"action":"execute","code":"\nvar orgAll = GameLogic.MetabolicSlice.ContentCatalog.OrganelleCatalog.All;\nint mechCovered = 0, mechNull = 0;\nforeach (var kv in orgAll) {\n    var mech = GameLogic.MetabolicSlice.ContentCatalog.StageSkinCatalog.GetMechName(kv.Key);\n    if (!string.IsNullOrEmpty(mech)) mechCovered++; else mechNull++;\n}\nreturn \"StageSkinCatalog Mech覆盖=\" + mechCovered + \" 未覆盖=\" + mechNull + \" 总数=\" + orgAll.Count;\n","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
{"ts":"2026-09-22T13:46:24.581Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":656,"action":"execute","params":{"action":"execute","code":"\nvar orgAll = GameLogic.MetabolicSlice.ContentCatalog.OrganelleCatalog.All;\nint mechCovered = 0, mechNull = 0;\nvar missing = new System.Collections.Generic.List<string>();\nforeach (var kv in orgAll) {\n    var mech = GameLogic.MetabolicSlice.ContentCatalog.StageSkinCatalog.GetDisplayName(kv.Key, GameLogic.MetabolicSlice.ContentCatalog.SkinTier.Mech);\n    if (!string.IsNullOrEmpty(mech)) mechCovered++; else { mechNull++; missing.Add(kv.Key); }\n}\nreturn \"StageSkinCatalog.Keys=\" + GameLogic.MetabolicSlice.ContentCatalog.StageSkinCatalog.Keys.Count + \" Mech覆盖=\" + mechCovered + \" 未覆盖=\" + mechNull + \" 总org数=\" + orgAll.Count + \"\\n缺=\" + string.Join(\",\", missing.GetRange(0, System.Math.Min(10, missing.Count)));\n","safety_checks":true,"compiler":"auto"}}
