{"ts":"2026-09-23T02:42:14.450Z","tool":"read_console","type":"tool","status":"SUCCESS","ms":6,"action":"get","params":{"action":"get","types":["error","warning"],"count":50,"format":"plain","includeStacktrace":false}}
{"ts":"2026-09-23T02:42:29.412Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":517,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n    var plusItems = System.Linq.Enumerable.ToList(System.Linq.Enumerable.Where(state.PrimitiveChips, p => p.CardDefId == \"organ_focus_plus\"));\n    results.Add(\"INFO organ_focus_plus instances in this session: \" + plusItems.Count);\n    Check(\"at least one organ_focus_plus exists from earlier successful upgrades\", plusItems.Count > 0, null);\n\n    if (plusItems.Count > 0)\n    {\n        // 精校镜装入电路，对比与普通聚焦镜的战斗预览差异（AC-PRM-009 \"必须产生真实差异\"）\n        var boardPlus = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n            GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, \"comp_gun\", null, null, System.Array.Empty<string>());\n        var plusRec = plusItems[0];\n        var eqPlus = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, boardPlus, \"bp_erc003\", 1, plusRec.PartId);\n        Check(\"organ_focus_plus can be equipped into circuit board (legal chip content)\", eqPlus.Success, eqPlus.Message);\n        boardPlus.TryAddEdge(0, 1);\n        boardPlus.TryAddEdge(1, 2); // 若1-2已存在会被拒绝，用TryAddEdge容错检查\n        var validationPlus = boardPlus.Validate();\n        results.Add(\"INFO board with focus_plus validation issues: \" + string.Join(\";\", System.Linq.Enumerable.Select(validationPlus.Issues, i => i.Code)));\n        var previewPlus = GameLogic.Campaign.Blueprint.BlueprintCircuitCompiler.CompilePreview(boardPlus, seed: 42);\n        results.Add(\"INFO preview with organ_focus_plus: damage=\" + previewPlus.TotalNormalizedDamage + \" pathCount=\" + previewPlus.PathCount);\n\n        // 对照组：普通聚焦镜装同一槽，同种子\n        var boardBasic = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n            GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, \"comp_gun\", null, null, System.Array.Empty<string>());\n        boardBasic.TryPlaceChip(1, \"organ_focus\");\n        boardBasic.TryAddEdge(0, 1);\n        var previewBasic = GameLogic.Campaign.Blueprint.BlueprintCircuitCompiler.CompilePreview(boardBasic, seed: 42);\n        results.Add(\"INFO preview with organ_focus (basic): damage=\" + previewBasic.TotalNormalizedDamage + \" pathCount=\" + previewBasic.PathCount);\n\n        Check(\"organ_focus_plus produces a measurably different preview result than organ_focus (real differentiation)\",\n            System.Math.Abs(previewPlus.TotalNormalizedDamage - previewBasic.TotalNormalizedDamage) > 0.01f,\n            \"plus=\" + previewPlus.TotalNormalizedDamage + \" basic=\" + previewBasic.TotalNormalizedDamage);\n    }\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:42:47.239Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":474,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n\n    // ── 取消 Queued 态（尚未 Reserve，验证全额释放场景在\"尚未真正扣款\"分支下同样正确）──\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    var freshItems = System.Linq.Enumerable.ToList(System.Linq.Enumerable.Where(\n        GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state), p => p.CardDefId == \"organ_focus\" && string.IsNullOrEmpty(p.ReservedByTransactionId)));\n    Check(\"have 2 materials for Queued-cancel test\", freshItems.Count >= 2, \"count=\" + freshItems.Count);\n    var enq = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueUpgrade(state, freshItems[0].PartId, freshItems[1].PartId);\n    Check(\"enqueue for Queued-cancel test\", enq.Success, enq.FailureReason);\n    var itemImmediate = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, enq.QueueItemId);\n    Check(\"still Queued (not yet ticked)\", itemImmediate.State == GameLogic.Campaign.CraftQueueState.Queued, itemImmediate.State.ToString());\n    int scrapBeforeQueuedCancel = state.Scrap;\n    var cancelQueued = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryCancel(state, enq.QueueItemId);\n    Check(\"cancel from Queued succeeds\", cancelQueued.Success, cancelQueued.FailureReason);\n    Check(\"Scrap unaffected (was never deducted)\", state.Scrap == scrapBeforeQueuedCancel, null);\n    var rec0 = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, freshItems[0].PartId);\n    var rec1 = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, freshItems[1].PartId);\n    Check(\"both materials released back to unreserved Bag\", string.IsNullOrEmpty(rec0.ReservedByTransactionId) && string.IsNullOrEmpty(rec1.ReservedByTransactionId), null);\n\n    // ── 读坏档防御：CraftQueues=null ──────────────────────\n    var corruptState = GameLogic.Campaign.CampaignState.CreateNew(\"craft-corrupt-test\", \"Standard\", 1);\n    corruptState.CraftQueues = null;\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(corruptState, 0.1f); // 应安全 no-op\n    Check(\"Tick tolerates null CraftQueues without throwing\", true, null);\n    var findNull = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(corruptState, \"anything\");\n    Check(\"Find tolerates null CraftQueues\", findNull == null, null);\n    corruptState.NormalizeForSave();\n    Check(\"NormalizeForSave regularizes null CraftQueues to empty array\", corruptState.CraftQueues != null, null);\n    string fp = GameLogic.Campaign.CampaignFingerprint.Compute(corruptState);\n    Check(\"Fingerprint handles null CraftQueues\", !string.IsNullOrEmpty(fp), null);\n\n    var enqOnCorrupt = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueDisassemble(corruptState, \"nonexistent\");\n    Check(\"TryEnqueueDisassemble on part-not-found handled gracefully (not throwing)\", !enqOnCorrupt.Success, enqOnCorrupt.FailureReason);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
