{"ts":"2026-09-23T02:14:19.639Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1163,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\ntry\n{\n    string campaignId = System.Guid.NewGuid().ToString(\"N\");\n    int seed = GameLogic.Campaign.CampaignRandomService.GenerateSeed();\n    var state = GameLogic.Campaign.CampaignState.CreateNew(campaignId, \"Standard\", seed);\n    var saveResult = GameLogic.Campaign.CampaignSaveService.Save(0, state, GameLogic.Campaign.SaveReason.NewCampaign);\n    results.Add(\"Save success=\" + saveResult.Success);\n    GameLogic.Campaign.MachineRegistry.ResetForNewCampaign();\n    GameLogic.Campaign.CampaignSession.Set(0, state);\n    GameApp.MountGameplayUi();\n    GameLogic.Stage.GameRoot.StartHomeValley();\n    results.Add(\"HomeValley entered. IsActive=\" + GameLogic.Stage.GameRoot.HomeValley.IsActive);\n\n    var cs = GameLogic.Campaign.CampaignSession.Current;\n    results.Add(\"PrimitiveChips.Length=\" + (cs.PrimitiveChips?.Length ?? -1));\n    foreach (var p in cs.PrimitiveChips ?? System.Array.Empty<GameLogic.Campaign.PrimitiveChipRecord>())\n    {\n        results.Add(\"  seed chip: PartId=\" + p.PartId + \" CardDefId=\" + p.CardDefId + \" State=\" + p.State);\n    }\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:14:28.283Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":577,"action":"execute","params":{"action":"execute","code":"\nvar cs = GameLogic.Campaign.CampaignSession.Current;\nvar station = System.Linq.Enumerable.FirstOrDefault(cs.BuildingRecords, b => b.BuildingTypeId == GameLogic.Campaign.Regions.HomeValleyLayout.BuildingTypeAssemblyStation);\nreturn \"station=\" + (station == null ? \"null\" : \"Construction=\" + station.ConstructionState + \" Power=\" + station.PowerState) + \" Scrap=\" + cs.Scrap;\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:14:50.970Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":494,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n\n    // ── 1) EnsureSeeded 幂等 ──────────────────────────────\n    int before = state.PrimitiveChips.Length;\n    GameLogic.Campaign.Primitive.PrimitiveInventory.EnsureSeeded(state);\n    Check(\"EnsureSeeded idempotent (count unchanged)\", state.PrimitiveChips.Length == before, \"before=\" + before + \" after=\" + state.PrimitiveChips.Length);\n\n    // ── 2) TryPrintChip 缺电拒绝且零扣款 ──────────────────\n    int scrapBefore = state.Scrap;\n    var printNoPower = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, GameLogic.Campaign.Primitive.PrimitiveInventory.DefaultChipContentId);\n    Check(\"TryPrintChip rejects when station Brownout\", !printNoPower.Success, printNoPower.Code + \":\" + printNoPower.Message);\n    Check(\"TryPrintChip no-power leaves Scrap unchanged\", state.Scrap == scrapBefore, \"before=\" + scrapBefore + \" after=\" + state.Scrap);\n\n    // ── 3) 未解锁内容拒绝补印 ──────────────────────────────\n    var printLocked = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus_plus\");\n    Check(\"TryPrintChip rejects unlocked-only content (organ_focus_plus)\", !printLocked.Success, printLocked.Code);\n\n    // ── 4) 修复发电机，让装配站真正 Powered ──────────────────\n    var generator = System.Linq.Enumerable.FirstOrDefault(state.BuildingRecords, b => b.BuildingTypeId == \"generator\");\n    Check(\"generator building found\", generator != null, null);\n    generator.ConstructionState = GameLogic.Campaign.BuildingConstructionState.Operational;\n    GameLogic.Campaign.Regions.HomeValleyPowerGrid.Recompute(state);\n    var station = System.Linq.Enumerable.FirstOrDefault(state.BuildingRecords, b => b.BuildingTypeId == GameLogic.Campaign.Regions.HomeValleyLayout.BuildingTypeAssemblyStation);\n    Check(\"assembly station now Powered\", station.PowerState == GameLogic.Campaign.BuildingPowerState.Powered, \"Power=\" + station.PowerState);\n\n    // ── 5) 真实补印成功，扣款5废料 ──────────────────────────\n    scrapBefore = state.Scrap;\n    int bagBefore = GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state);\n    var printOk = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, GameLogic.Campaign.Primitive.PrimitiveInventory.DefaultChipContentId);\n    Check(\"TryPrintChip succeeds when powered+unlocked+bag not full\", printOk.Success, printOk.Message);\n    Check(\"TryPrintChip deducts exactly 5 scrap\", state.Scrap == scrapBefore - 5, \"before=\" + scrapBefore + \" after=\" + state.Scrap);\n    Check(\"TryPrintChip increases BagCount by 1\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == bagBefore + 1, null);\n\n    // ── 6) 解析发放 + 同源去重幂等 ──────────────────────────\n    var grant1 = GameLogic.Campaign.Primitive.PrimitiveInventory.TryGrantFromSalvage(state, \"salvage-001\", \"organ_focus\");\n    Check(\"TryGrantFromSalvage succeeds for whitelisted content\", grant1.Success, grant1.Message);\n    int countAfterGrant1 = state.PrimitiveChips.Length;\n    var grant1Again = GameLogic.Campaign.Primitive.PrimitiveInventory.TryGrantFromSalvage(state, \"salvage-001\", \"organ_focus\");\n    Check(\"TryGrantFromSalvage idempotent for same salvageInstanceId\", grant1Again.Success && state.PrimitiveChips.Length == countAfterGrant1,\n        \"before=\" + countAfterGrant1 + \" after=\" + state.PrimitiveChips.Length);\n\n    // ── 7) 主线组件不能被误转基元芯片 ──────────────────────\n    var grantIllegal = GameLogic.Campaign.Primitive.PrimitiveInventory.TryGrantFromSalvage(state, \"salvage-illegal-001\", \"comp_gun\");\n    Check(\"TryGrantFromSalvage rejects non-chip-source content (comp_gun)\", !grantIllegal.Success, grantIllegal.Code);\n    var grantIllegal2 = GameLogic.Campaign.Primitive.PrimitiveInventory.TryGrantFromSalvage(state, \"salvage-illegal-002\", \"gene_taxis\");\n    Check(\"TryGrantFromSalvage rejects non-chip-source content (gene_taxis firmware)\", !grantIllegal2.Success, grantIllegal2.Code);\n\n    results.Add(\"INFO current PrimitiveChips.Length=\" + state.PrimitiveChips.Length + \" BagCount=\" + GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state));\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:15:09.313Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":562,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n    int bag = GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state);\n    results.Add(\"INFO starting BagCount=\" + bag);\n    // 印到仓满 (Capacity=8)\n    while (GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) < GameLogic.Campaign.Primitive.PrimitiveInventory.Capacity)\n    {\n        var r = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, GameLogic.Campaign.Primitive.PrimitiveInventory.DefaultChipContentId);\n        if (!r.Success) { results.Add(\"FAIL fill-to-capacity print failed: \" + r.Code + \" \" + r.Message); break; }\n    }\n    Check(\"Bag filled to exactly capacity 8\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 8, \"actual=\" + GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state));\n\n    // 仓满时补印应被拒绝且零扣款\n    int scrapBefore = state.Scrap;\n    var printFull = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, GameLogic.Campaign.Primitive.PrimitiveInventory.DefaultChipContentId);\n    Check(\"TryPrintChip rejects when bag full\", !printFull.Success, printFull.Code);\n    Check(\"bag-full print leaves Scrap unchanged\", state.Scrap == scrapBefore, \"before=\" + scrapBefore + \" after=\" + state.Scrap);\n\n    // 仓满时解析发放进入 Pending 而不是拒绝/丢失\n    var grantWhenFull = GameLogic.Campaign.Primitive.PrimitiveInventory.TryGrantFromSalvage(state, \"salvage-overflow-001\", \"organ_focus\");\n    Check(\"TryGrantFromSalvage succeeds even when bag full (goes Pending)\", grantWhenFull.Success, grantWhenFull.Message);\n    var pendingList = GameLogic.Campaign.Primitive.PrimitiveInventory.PendingItems(state);\n    Check(\"New instance is in Pending state when bag full\", pendingList.Count == 1, \"count=\" + pendingList.Count);\n    string pendingPartId = pendingList.Count > 0 ? pendingList[0].PartId : null;\n\n    // 领取待领取：仓满时应拒绝\n    var claimWhenFull = GameLogic.Campaign.Primitive.PrimitiveInventory.TryClaimPending(state, pendingPartId);\n    Check(\"TryClaimPending rejects when bag still full\", !claimWhenFull.Success, claimWhenFull.Code);\n\n    // 腾一个格子（把一个Bag实例移进电路草稿的Draft态），再领取应成功\n    var board = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n        GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, \"comp_gun\", null, null, System.Array.Empty<string>());\n    var bagItems = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state);\n    string moveOutPartId = bagItems[0].PartId;\n    var moveToDraft = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 1, moveOutPartId);\n    Check(\"TryMoveToDraft succeeds (Bag -> Draft)\", moveToDraft.Success, moveToDraft.Message);\n    Check(\"BagCount decreased by 1 after move-to-draft\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 7, \"actual=\" + GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state));\n    Check(\"board.SlotContentIds[1] == organ_focus\", board.SlotContentIds[1] == \"organ_focus\", board.SlotContentIds[1]);\n    Check(\"board.SlotPartIds[1] == moved partId\", board.SlotPartIds[1] == moveOutPartId, board.SlotPartIds[1]);\n    var movedRecord = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, moveOutPartId);\n    Check(\"record.State == Draft after move\", movedRecord.State == GameLogic.Campaign.PrimitiveChipState.Draft, movedRecord.State.ToString());\n    Check(\"record.DraftBlueprintId == bp_erc003\", movedRecord.DraftBlueprintId == \"bp_erc003\", movedRecord.DraftBlueprintId);\n    Check(\"record.DraftSlot == 1\", movedRecord.DraftSlot == 1, movedRecord.DraftSlot.ToString());\n\n    // 现在应该有空位了，领取待领取成功\n    var claimNow = GameLogic.Campaign.Primitive.PrimitiveInventory.TryClaimPending(state, pendingPartId);\n    Check(\"TryClaimPending succeeds once bag has space\", claimNow.Success, claimNow.Message);\n    Check(\"Pending list empty after claim\", GameLogic.Campaign.Primitive.PrimitiveInventory.PendingItems(state).Count == 0, null);\n    Check(\"BagCount == 8 after claim (back to full)\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 8, \"actual=\" + GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state));\n\n    results.Add(\"INFO total PrimitiveChips=\" + state.PrimitiveChips.Length);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:15:27.966Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":463,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n    var board = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n        GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, \"comp_gun\", null, null, System.Array.Empty<string>());\n\n    // ── 卸回 ──────────────────────────────────────────────\n    var bagItems = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state);\n    string partA = bagItems[0].PartId;\n    var eq = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 2, partA);\n    Check(\"setup: equip partA into slot2\", eq.Success, eq.Message);\n    int bagBeforeUnequip = GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state);\n    var unequip = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToBag(state, board, 2);\n    Check(\"TryMoveToBag succeeds\", unequip.Success, unequip.Message);\n    Check(\"BagCount +1 after unequip\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == bagBeforeUnequip + 1, null);\n    Check(\"board.SlotContentIds[2] cleared\", string.IsNullOrEmpty(board.SlotContentIds[2]), board.SlotContentIds[2]);\n    Check(\"board.SlotPartIds[2] cleared\", board.SlotPartIds[2] == null, board.SlotPartIds[2]);\n    var recA = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partA);\n    Check(\"record back to Bag state\", recA.State == GameLogic.Campaign.PrimitiveChipState.Bag, recA.State.ToString());\n    Check(\"record DraftSlot reset to -1\", recA.DraftSlot == -1, recA.DraftSlot.ToString());\n\n    // ── 非法装入：槽已被占用应原子失败，不改仓状态 ──────────\n    string partB = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state)[0].PartId;\n    string partC = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state)[1].PartId;\n    var eqB = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 3, partB);\n    Check(\"setup: equip partB into slot3\", eqB.Success, eqB.Message);\n    var eqCIntoOccupied = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 3, partC);\n    Check(\"TryMoveToDraft rejects occupied slot\", !eqCIntoOccupied.Success, eqCIntoOccupied.Code);\n    var recC = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partC);\n    Check(\"partC stayed in Bag after rejected move (atomic, no partial state)\", recC.State == GameLogic.Campaign.PrimitiveChipState.Bag, recC.State.ToString());\n\n    // ── 非法装入：0号固定槽应拒绝 ──────────────────────────\n    var eqIntoFixedSlot = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 0, partC);\n    Check(\"TryMoveToDraft rejects fixed slot 0\", !eqIntoFixedSlot.Success, eqIntoFixedSlot.Code);\n    recC = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partC);\n    Check(\"partC still in Bag after fixed-slot rejection\", recC.State == GameLogic.Campaign.PrimitiveChipState.Bag, recC.State.ToString());\n\n    // ── 找不到实例 / 实例不在仓中 ────────────────────────────\n    var eqNotFound = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 4, \"pchip_does_not_exist\");\n    Check(\"TryMoveToDraft rejects unknown partId\", !eqNotFound.Success, eqNotFound.Code);\n    var eqAlreadyDraft = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 4, partB);\n    Check(\"TryMoveToDraft rejects instance already Draft elsewhere\", !eqAlreadyDraft.Success, eqAlreadyDraft.Code);\n\n    results.Add(\"INFO board slot3 content=\" + board.SlotContentIds[3] + \" partId=\" + board.SlotPartIds[3]);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
