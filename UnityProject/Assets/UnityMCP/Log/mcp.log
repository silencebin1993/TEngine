{"ts":"2026-09-22T14:18:24.763Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":684,"action":"execute","params":{"action":"execute","code":"\nvar state = GameLogic.Campaign.CampaignSession.Current;\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"BlueprintRecords count=\" + (state.BlueprintRecords?.Length ?? -1));\nforeach (var r in state.BlueprintRecords)\n{\n    var v = r.Versions.First(x => x.Version == r.ActiveVersion);\n    sb.AppendLine($\"{r.BlueprintId}: Chassis={v.ChassisId} Primary={v.PrimaryId} Slots0={v.CircuitSlotContentIds?[0]} Slots8={v.CircuitSlotContentIds?[8]} Edges={v.CircuitEdges?.Length} ScrapCost={v.ScrapCost}\");\n}\nvar m1 = GameLogic.Campaign.MachineRegistry.AllRecords.Where(r => r.RegionId == GameLogic.Campaign.Regions.HomeValleyLayout.RegionId);\nforeach (var m in m1) sb.AppendLine($\"Machine {m.LogicId} chassis={m.ChassisId} blueprintId={m.BlueprintId}\");\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
