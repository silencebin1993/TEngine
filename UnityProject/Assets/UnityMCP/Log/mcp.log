{"ts":"2026-09-22T14:17:50.540Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1282,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nvoid Check(bool cond, string label) { results.Add((cond ? \"PASS\" : \"FAIL\") + \": \" + label); }\n\nvar board = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n    GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n    new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId });\nboard.TryPlaceChip(4, \"organ_focus\");\nvar originalVersion = board.ToVersion(1, 12.5f);\nstring originalSig = originalVersion.CompileSignature;\nstring json = UnityEngine.JsonUtility.ToJson(originalVersion);\n\nbool allMatch = true;\nfor (int i = 0; i < 20; i++)\n{\n    var restored = UnityEngine.JsonUtility.FromJson<GameLogic.Campaign.BlueprintVersionRecord>(json);\n    var restoredBoard = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.FromVersion(restored);\n    var restoredVersion = restoredBoard.ToVersion(1, 12.5f);\n    json = UnityEngine.JsonUtility.ToJson(restoredVersion);\n    if (restoredVersion.CompileSignature != originalSig) { allMatch = false; results.Add($\"FAIL at iter {i}: {restoredVersion.CompileSignature}\"); }\n}\nCheck(allMatch, \"20次存读档往返签名与原始签名逐字节一致, 签名=\" + originalSig);\n\n// 存档指纹(CampaignFingerprint风格): 校验槽位内容和边数组也逐一相同\nvar finalRestored = UnityEngine.JsonUtility.FromJson<GameLogic.Campaign.BlueprintVersionRecord>(json);\nCheck(finalRestored.CircuitSlotContentIds.SequenceEqual(originalVersion.CircuitSlotContentIds), \"20轮后CircuitSlotContentIds逐元素相同\");\nCheck(finalRestored.CircuitEdges.Length == originalVersion.CircuitEdges.Length &&\n    finalRestored.CircuitEdges.Select(e=>(e.From,e.To)).SequenceEqual(originalVersion.CircuitEdges.Select(e=>(e.From,e.To))),\n    \"20轮后CircuitEdges逐条相同\");\n\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
