{"ts":"2026-09-22T14:15:37.565Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":732,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nvoid Check(bool cond, string label) { results.Add((cond ? \"PASS\" : \"FAIL\") + \": \" + label); }\n\nvar b3 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n    GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n    new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId });\nCheck(b3.SlotContentIds.Length == 9, \"ERC-003 九槽长度=9\");\nCheck(b3.SlotContentIds[0] == \"organ_core\", \"0号源槽默认organ_core, 实际=\" + b3.SlotContentIds[0]);\nCheck(b3.SlotContentIds[8] == \"org_emitter\", \"8号汇槽由comp_gun派生=org_emitter, 实际=\" + b3.SlotContentIds[8]);\nCheck(b3.Edges.Count == 4 && b3.Edges.Contains((0,1)) && b3.Edges.Contains((1,2)) && b3.Edges.Contains((2,5)) && b3.Edges.Contains((5,8)),\n    \"默认线0->1->2->5->8存在\");\nvar v3result = b3.Validate();\nCheck(v3result.IsValid, \"ERC-003默认板校验通过(0问题), 实际问题数=\" + v3result.Issues.Count);\nCheck(v3result.PathCount == 1, \"ERC-003默认板恰好1条路径, 实际=\" + v3result.PathCount);\n\nCheck(GameLogic.Campaign.Blueprint.BlueprintCircuitLayout.SlotTypeAt(1) == GameLogic.MetabolicSlice.Grid.SlotType.Membrane, \"1号槽=减振(Membrane)\");\nCheck(GameLogic.Campaign.Blueprint.BlueprintCircuitLayout.SlotTypeAt(2) == GameLogic.MetabolicSlice.Grid.SlotType.Lattice, \"2号槽=高导(Lattice)\");\nCheck(GameLogic.Campaign.Blueprint.BlueprintCircuitLayout.SlotTypeAt(5) == GameLogic.MetabolicSlice.Grid.SlotType.Lattice, \"5号槽=高导(Lattice)\");\n\nvar previewErc003 = GameLogic.Campaign.Blueprint.BlueprintCircuitCompiler.CompilePreview(b3);\nCheck(previewErc003.HasCombatOutput && previewErc003.PathCount == 1 && previewErc003.TotalNormalizedDamage > 0f,\n    \"ERC-003默认线可攻击, damage=\" + previewErc003.TotalNormalizedDamage);\n\nvar bHauler = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc002ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompBeamId, null, null, System.Array.Empty<string>());\nvar previewHauler = GameLogic.Campaign.Blueprint.BlueprintCircuitCompiler.CompilePreview(bHauler);\nCheck(previewHauler.HasCombatOutput && previewHauler.PathCount == 1, \"搬运机默认线可攻击, damage=\" + previewHauler.TotalNormalizedDamage);\n\nvar bErc001 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc001ChassisId, null, null,\n    GameLogic.Campaign.Content.ComponentCatalog.StructCargoId, System.Array.Empty<string>());\nvar previewErc001 = GameLogic.Campaign.Blueprint.BlueprintCircuitCompiler.CompilePreview(bErc001);\nCheck(!previewErc001.HasCombatOutput, \"ERC-001(纯搬运)无可攻击输出,设计使然, NoteText=\" + previewErc001.NoteText);\nvar v001 = bErc001.Validate();\nCheck(v001.IsValid, \"ERC-001无武器但校验仍通过(不因无sink而报错), 实际问题数=\" + v001.Issues.Count);\n\nvar bHover = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Content.ChassisCatalog.ChassisHoverId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompRepairBeamId, null, null, System.Array.Empty<string>());\nvar previewHover = GameLogic.Campaign.Blueprint.BlueprintCircuitCompiler.CompilePreview(bHover);\nCheck(!previewHover.HasCombatOutput, \"维修机(维修束未映射AttackMethod)无可攻击输出,NoteText=\" + previewHover.NoteText);\n\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-22T14:16:02.950Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":546,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nvoid Check(bool cond, string label) { results.Add((cond ? \"PASS\" : \"FAIL\") + \": \" + label); }\n\n// ── 环拒绝 ──\nvar b = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId, null, null, System.Array.Empty<string>());\n// 追加成环: 1->3, 3->4, 4->1 (需先装芯片让1/3/4有内容以免\"孤立芯片\"干扰观察，但环检测应独立于是否装芯片)\nvar addA = b.TryAddEdge(1, 4); Check(addA.Success, \"画边1->4: \" + addA.Message);\nvar addB = b.TryAddEdge(4, 3); Check(addB.Success, \"画边4->3: \" + addB.Message);\nvar addC = b.TryAddEdge(3, 0); // 0是固定源槽,尝试连回0号槽制造环 1->4->3->0->1? 0->1已存在\nCheck(addC.Success, \"画边3->0: \" + addC.Message);\nvar v = b.Validate();\nCheck(v.Issues.Exists(i => i.Code == GameLogic.Campaign.Blueprint.CircuitIssueCode.HasCycle), \"环被检测到, 问题=\" + string.Join(\",\", v.Issues.Select(i=>i.Code)));\n\n// ── 非法边: 自环/越界/不相邻/重复 ──\nvar b2 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId, null, null, System.Array.Empty<string>());\nCheck(!b2.TryAddEdge(1, 1).Success, \"自环被拒绝\");\nCheck(!b2.TryAddEdge(1, 9).Success, \"越界被拒绝\");\nCheck(!b2.TryAddEdge(0, 8).Success, \"非相邻(0,8)被拒绝\");\nCheck(!b2.TryAddEdge(0, 1).Success, \"重复边(0->1已存在)被拒绝\");\n\n// ── 孤立芯片 ──\nvar b3 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId, null, null, System.Array.Empty<string>());\nvar place = b3.TryPlaceChip(4, \"organ_focus\"); Check(place.Success, \"装入4号槽organ_focus: \" + place.Message);\nvar v3 = b3.Validate();\nCheck(v3.Issues.Exists(i => i.Code == GameLogic.Campaign.Blueprint.CircuitIssueCode.IsolatedChip && i.Slots.Contains(4)),\n    \"4号槽孤立芯片被检出, 问题=\" + string.Join(\",\", v3.Issues.Select(i=>i.Code)));\n\n// ── 不可达(0条路径): 有汇但删掉唯一路径 ──\nvar b4 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId, null, null, System.Array.Empty<string>());\nb4.TryRemoveEdge(5, 8);\nvar v4 = b4.Validate();\nCheck(v4.Issues.Exists(i => i.Code == GameLogic.Campaign.Blueprint.CircuitIssueCode.NoValidPath), \"断开5->8后0条路径被检出, 问题=\" + string.Join(\",\", v4.Issues.Select(i=>i.Code)));\n\n// ── 1~4条路径: 在默认线基础上加平行支路，做到4条，再加第5条应拒绝保存 ──\nvar b5 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId, null, null, System.Array.Empty<string>());\n// 装3/4/6/7号槽以获得更多软帽额度(非空槽数增加edge cap = max(1,非空槽数)*2)\nb5.TryPlaceChip(3, \"organ_focus\"); b5.TryPlaceChip(4, \"organ_focus\"); b5.TryPlaceChip(6, \"organ_focus\"); b5.TryPlaceChip(7, \"organ_focus\");\n// 已有 0-1,1-2,2-5,5-8 (4条边). 加 0-3,3-4,4-5 (支路2: 0->3->4->5->8)\nb5.TryAddEdge(0,3); b5.TryAddEdge(3,4); b5.TryAddEdge(4,5);\n// 加 1-4 (支路3的一部分: 0->1->4->5->8, 需要4已有芯片, path通过4)\nb5.TryAddEdge(1,4);// wait 1和4不相邻(1=(1,0),4=(1,1)是相邻的，因为3x3网格index=row*3+col: 1=(row0,col1) 4=(row1,col1)，相邻)\n// 加 3-6, 6-7? 尝试组合更多路径\nvar addResult = b5.TryAddEdge(6,7);\nvar v5 = b5.Validate();\nresults.Add(\"INFO: 当前路径数=\" + v5.PathCount + \" 边数=\" + b5.Edges.Count + \" 问题=\" + string.Join(\",\", v5.Issues.Select(i=>i.Code)));\n\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-22T14:16:25.072Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":588,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nvoid Check(bool cond, string label) { results.Add((cond ? \"PASS\" : \"FAIL\") + \": \" + label); }\n\n// ── 环拒绝（正确姿势：先装芯片提升边数软帽，再连出环）──\nvar b = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId, null, null, System.Array.Empty<string>());\nb.TryPlaceChip(1, \"organ_focus\"); b.TryPlaceChip(3, \"organ_focus\"); b.TryPlaceChip(4, \"organ_focus\");\nvar e1 = b.TryAddEdge(1,4); var e2 = b.TryAddEdge(4,3); var e3 = b.TryAddEdge(3,0);\nCheck(e1.Success && e2.Success && e3.Success, $\"环用三条边全部添加成功 e1={e1.Success}/{e1.Message} e2={e2.Success}/{e2.Message} e3={e3.Success}/{e3.Message}\");\nvar v = b.Validate();\nCheck(v.Issues.Exists(i => i.Code == GameLogic.Campaign.Blueprint.CircuitIssueCode.HasCycle), \"环(0->1->4->3->0)被检测到, 问题=\" + string.Join(\",\", v.Issues.Select(i=>i.Code)));\n\n// ── >4 路径拒绝 ──\nvar b5 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId, null, null, System.Array.Empty<string>());\nforeach (int s in new[]{1,2,3,4,5,6,7}) b5.TryPlaceChip(s, \"organ_focus\");\n// 默认线: 0-1,1-2,2-5,5-8 (source0, sink8 fixed; slots 1..7 都已装芯片, cap=(2+7)*2=18)\n// 加多条支路制造 >4 简单路径: 0-3,3-4,4-5 / 0-1,1-4 / 3-6,6-7,7-8 / 4-7\nvar edges = new (int,int)[] { (0,3),(3,4),(4,5),(1,4),(3,6),(6,7),(7,8),(4,7),(2,5) };\nint added = 0;\nforeach (var (f,t) in edges) { var r = b5.TryAddEdge(f,t); if (r.Success) added++; }\nvar v5 = b5.Validate();\nresults.Add(\"INFO: 添加成功\" + added + \"/\" + edges.Length + \"条边, 总边数=\" + b5.Edges.Count + \", 路径数=\" + v5.PathCount + \", 问题=\" + string.Join(\",\", v5.Issues.Select(i=>i.Code)));\nCheck(v5.PathCount > 4 ? v5.Issues.Exists(i=>i.Code==GameLogic.Campaign.Blueprint.CircuitIssueCode.TooManyPaths) : true,\n    \"路径数>4时TooManyPaths被检出(若路径数<=4则跳过本断言)\");\n\n// ── 负载超额 ──\nvar bLoad = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, // chassis_track Load=7\n    GameLogic.Campaign.Content.ComponentCatalog.CompCannonId,   // Load=4 (重炮)\n    GameLogic.Campaign.Content.ComponentCatalog.FuncDashId,     // Load=1\n    GameLogic.Campaign.Content.ComponentCatalog.StructArmorId,  // Load=3\n    new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwOverloadId, GameLogic.Campaign.Content.FirmwareCatalog.FwArmorPierceId }); // Load=1+1\n// 总负载 = 4+1+3+1+1 = 10 > chassisTrack.Load=7\nvar vLoad = bLoad.Validate();\nCheck(vLoad.Issues.Exists(i=>i.Code==GameLogic.Campaign.Blueprint.CircuitIssueCode.LoadExceeded), \"负载超额(10>7)被检出, 问题=\" + string.Join(\",\", vLoad.Issues.Select(i=>i.Code)));\n\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-22T14:16:43.296Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":561,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nvoid Check(bool cond, string label) { results.Add((cond ? \"PASS\" : \"FAIL\") + \": \" + label); }\n\n// ── 稳定签名 ──\nvar mk = () => GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n    GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n    new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId });\nvar sigA = mk().ComputeSignature();\nvar sigB = mk().ComputeSignature();\nCheck(sigA == sigB, \"同结构两次生成签名相同: \" + sigA);\n\nvar bChanged = mk();\nbChanged.TryPlaceChip(4, \"organ_focus\");\nCheck(bChanged.ComputeSignature() != sigA, \"装芯片后签名改变\");\n\nvar bEdge = mk();\nbEdge.TryPlaceChip(3,\"organ_focus\"); bEdge.TryPlaceChip(4,\"organ_focus\");\nbEdge.TryAddEdge(0,3); // 加一条边\nCheck(bEdge.ComputeSignature() != sigA, \"加边后签名改变\");\n\n// DEBT-ER4PRIM01-01: 0号源槽内容真实参与签名与预览\nvar bSrc1 = mk(); var sigSrc1 = bSrc1.ComputeSignature();\nvar bSrc2 = mk(); bSrc2.TrySetSource(\"org_mito\"); var sigSrc2 = bSrc2.ComputeSignature();\nCheck(sigSrc1 != sigSrc2, \"0号源槽从organ_core切到org_mito后签名改变(DEBT-ER4PRIM01-01裁决落点)\");\nvar previewSrc1 = GameLogic.Campaign.Blueprint.BlueprintCircuitCompiler.CompilePreview(bSrc1);\nvar previewSrc2 = GameLogic.Campaign.Blueprint.BlueprintCircuitCompiler.CompilePreview(bSrc2);\nresults.Add(\"INFO: organ_core预览伤害=\" + previewSrc1.TotalNormalizedDamage + \" org_mito预览伤害=\" + previewSrc2.TotalNormalizedDamage + \"（当前两者BaseOutput均为10f默认值，数值相同是预期——见证据文档DEBT裁决说明）\");\n\n// 固件顺序影响签名\nvar bFw1 = mk();\nvar bFw2 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n    GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n    new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId, GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId }); // 顺序反过来\nCheck(bFw1.ComputeSignature() != bFw2.ComputeSignature(), \"固件顺序反转后签名改变\");\n\n// ── 撤销/重做 20+ 步 ──\nvar bUndo = mk();\nfor (int i = 1; i <= 25; i++) bUndo.TryPlaceChip(4, \"organ_focus\"); // 重复装同一个不会push(内容相同?) 用交替避免no-op\n// 交替装/卸以确保每步都真的改变状态\nvar bUndo2 = mk();\nint successfulOps = 0;\nfor (int i = 0; i < 25; i++)\n{\n    if (i % 2 == 0) { var r = bUndo2.TryPlaceChip(4, \"organ_focus\"); if (r.Success) successfulOps++; }\n    else { var r = bUndo2.TryRemoveChip(4); if (r.Success) successfulOps++; }\n}\nresults.Add(\"INFO: 25次交替装卸成功次数=\" + successfulOps + \" UndoDepth=\" + bUndo2.UndoDepth);\nCheck(bUndo2.UndoDepth == 20, \"UndoDepth封顶在20步, 实际=\" + bUndo2.UndoDepth);\nint undoCount = 0;\nwhile (bUndo2.Undo()) undoCount++;\nCheck(undoCount == 20, \"能撤销恰好20步, 实际=\" + undoCount);\nCheck(bUndo2.RedoDepth == 20, \"撤销20步后RedoDepth=20, 实际=\" + bUndo2.RedoDepth);\nint redoCount = 0;\nwhile (bUndo2.Redo()) redoCount++;\nCheck(redoCount == 20, \"能重做恰好20步, 实际=\" + redoCount);\n\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-22T14:17:04.518Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":603,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nvoid Check(bool cond, string label) { results.Add((cond ? \"PASS\" : \"FAIL\") + \": \" + label); }\n\n// ── 20次存读档往返(JsonUtility序列化), 签名/槽位/边逐字节一致 ──\nvar board = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n    GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n    GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n    new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId });\nboard.TryPlaceChip(4, \"organ_focus\");\nvar originalVersion = board.ToVersion(1, 12.5f);\nstring originalJson = UnityEngine.JsonUtility.ToJson(originalVersion);\n\nbool allRoundtripsMatch = true;\nstring lastSig = originalVersion.CompileSignature;\nfor (int i = 0; i < 20; i++)\n{\n    var restored = UnityEngine.JsonUtility.FromJson<GameLogic.Campaign.BlueprintVersionRecord>(originalJson);\n    var restoredBoard = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.FromVersion(restored);\n    var restoredVersion = restoredBoard.ToVersion(1, 12.5f);\n    string restoredJson = UnityEngine.JsonUtility.ToJson(restoredVersion);\n    if (restoredVersion.CompileSignature != lastSig) { allRoundtripsMatch = false; results.Add($\"FAIL at iter {i}: sig changed {lastSig} -> {restoredVersion.CompileSignature}\"); }\n    originalJson = restoredJson; // 链式：下一轮用这一轮的输出再往返\n}\nCheck(allRoundtripsMatch, \"20次存读档往返签名保持不变, 最终签名=\" + lastSig);\n\n// ── 旧schema迁移: 构造一个\"缺电路数据\"的BlueprintVersionRecord(模拟ER1-SAVE-01~ER4-FAC-01期间旧档) ──\nvar state = new GameLogic.Campaign.CampaignState { PlaySeconds = 5f };\nvar oldSkeletonVersion = new GameLogic.Campaign.BlueprintVersionRecord\n{\n    Version = 1,\n    ChassisId = GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n    PrimaryId = null, UtilityId = null, StructureId = null,\n    OrderedFirmwareIds = System.Array.Empty<string>(),\n    ScrapCost = 60, CompileSignature = GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc003Id + \":v1\",\n    CircuitSlotContentIds = null, CircuitEdges = null, CircuitSlotTypes = null,\n};\nstate.BlueprintRecords = new[] {\n    new GameLogic.Campaign.BlueprintRecord {\n        BlueprintId = GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc003Id,\n        DisplayName = \"战斗履带 ERC-003\", ActiveVersion = 1, Versions = new[]{ oldSkeletonVersion },\n    }\n};\nGameLogic.Campaign.Blueprint.BlueprintCircuitDefaults.EnsureCircuitDataSeeded(state);\n\nvar migrated = state.BlueprintRecords.First(b=>b.BlueprintId==GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc003Id).Versions[0];\nCheck(migrated.CircuitSlotContentIds != null && migrated.CircuitSlotContentIds.Length == 9, \"旧档迁移后CircuitSlotContentIds补齐9槽\");\nCheck(migrated.PrimaryId == GameLogic.Campaign.Content.ComponentCatalog.CompGunId, \"旧档迁移后PrimaryId补成默认连射器comp_gun, 实际=\" + migrated.PrimaryId);\nCheck(migrated.ScrapCost == 60, \"迁移后ScrapCost仍精确=60(与HomeValleyLayout.FactoryProduceDefaults既有数字一致), 实际=\" + migrated.ScrapCost);\nCheck(migrated.CircuitEdges != null && migrated.CircuitEdges.Length == 4, \"迁移后CircuitEdges=默认线4条边, 实际=\" + (migrated.CircuitEdges?.Length ?? -1));\n\n// bp_erc001新增蓝图自动补齐\nvar erc001Record = state.BlueprintRecords.FirstOrDefault(b=>b.BlueprintId==GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc001Id);\nCheck(erc001Record != null, \"EnsureCircuitDataSeeded自动补齐bp_erc001蓝图\");\nCheck(erc001Record?.Versions[0].StructureId == GameLogic.Campaign.Content.ComponentCatalog.StructCargoId, \"bp_erc001默认StructureId=struct_cargo(货舱)\");\n\n// ── ScrapCost与既有FactoryProduceDefaults数字回归核对(35/55) ──\nGameLogic.Campaign.Regions.HomeValleyLayout.FactoryProduceDefaults.TryGetValue(GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintHaulerId, out var haulerDef);\nGameLogic.Campaign.Regions.HomeValleyLayout.FactoryProduceDefaults.TryGetValue(GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintHoverId, out var hoverDef);\nvar haulerBoard = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(GameLogic.Campaign.Regions.HomeValleyLayout.Erc002ChassisId, GameLogic.Campaign.Content.ComponentCatalog.CompBeamId, null, null, System.Array.Empty<string>());\nvar haulerVersion = haulerBoard.ToVersion(1, 0f);\nCheck(haulerVersion.ScrapCost == haulerDef.ScrapCost, $\"重算的bp_hauler ScrapCost({haulerVersion.ScrapCost})与既有数字({haulerDef.ScrapCost})一致\");\nvar hoverBoard = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(GameLogic.Campaign.Content.ChassisCatalog.ChassisHoverId, GameLogic.Campaign.Content.ComponentCatalog.CompRepairBeamId, null, null, System.Array.Empty<string>());\nvar hoverVersion = hoverBoard.ToVersion(1, 0f);\nCheck(hoverVersion.ScrapCost == hoverDef.ScrapCost, $\"重算的bp_hover ScrapCost({hoverVersion.ScrapCost})与既有数字({hoverDef.ScrapCost})一致\");\n\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
