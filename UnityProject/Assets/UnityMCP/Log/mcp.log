{"ts":"2026-09-23T02:38:18.606Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1247,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    string campaignId = System.Guid.NewGuid().ToString(\"N\");\n    int seed = GameLogic.Campaign.CampaignRandomService.GenerateSeed();\n    var state = GameLogic.Campaign.CampaignState.CreateNew(campaignId, \"Standard\", seed);\n    GameLogic.Campaign.CampaignSaveService.Save(0, state, GameLogic.Campaign.SaveReason.NewCampaign);\n    GameLogic.Campaign.MachineRegistry.ResetForNewCampaign();\n    GameLogic.Campaign.CampaignSession.Set(0, state);\n    GameApp.MountGameplayUi();\n    GameLogic.Stage.GameRoot.StartHomeValley();\n    state = GameLogic.Campaign.CampaignSession.Current;\n    Check(\"fresh campaign, HomeValley active\", GameLogic.Stage.GameRoot.HomeValley.IsActive, null);\n\n    var generator = System.Linq.Enumerable.FirstOrDefault(state.BuildingRecords, b => b.BuildingTypeId == \"generator\");\n    generator.ConstructionState = GameLogic.Campaign.BuildingConstructionState.Operational;\n    GameLogic.Campaign.Regions.HomeValleyPowerGrid.Recompute(state);\n\n    // 补印到有2件聚焦镜可用（开局seed 1件 + 补印1件）\n    var printR = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    Check(\"print second focus lens\", printR.Success, printR.Message);\n    Check(\"bag has 2 organ_focus items\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 2, null);\n\n    var bagItems = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state);\n    string partA = bagItems[0].PartId, partB = bagItems[1].PartId;\n\n    // ── 非法入队：材料相同实例 ──────────────────────────\n    var sameMat = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueUpgrade(state, partA, partA);\n    Check(\"TryEnqueueUpgrade rejects same instance twice\", !sameMat.Success, sameMat.FailureReason);\n\n    // ── 真实入队升级 ──────────────────────────────────\n    int scrapBefore = state.Scrap;\n    var enqueue = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueUpgrade(state, partA, partB);\n    Check(\"TryEnqueueUpgrade succeeds with 2 distinct organ_focus\", enqueue.Success, enqueue.FailureReason);\n    Check(\"Scrap unchanged at enqueue time (only Propose, no Reserve yet)\", state.Scrap == scrapBefore, \"before=\" + scrapBefore + \" after=\" + state.Scrap);\n\n    var recA = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partA);\n    var recB = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partB);\n    Check(\"Material A reserved\", recA.ReservedByTransactionId == enqueue.QueueItemId, recA.ReservedByTransactionId);\n    Check(\"Material B reserved\", recB.ReservedByTransactionId == enqueue.QueueItemId, recB.ReservedByTransactionId);\n    Check(\"Materials still Bag state (reserved, not consumed)\", recA.State == GameLogic.Campaign.PrimitiveChipState.Bag && recB.State == GameLogic.Campaign.PrimitiveChipState.Bag, null);\n\n    var item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, enqueue.QueueItemId);\n    Check(\"queue item Queued\", item.State == GameLogic.Campaign.CraftQueueState.Queued, item.State.ToString());\n\n    // ── 预留后不能被电路板装/卸 ──────────────────────────\n    var board = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n        GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, \"comp_gun\", null, null, System.Array.Empty<string>());\n    var blockedEquip = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 1, partA);\n    Check(\"Reserved instance cannot be equipped to circuit board\", !blockedEquip.Success, blockedEquip.Code);\n\n    results.Add(\"INFO queueItemId=\" + enqueue.QueueItemId + \" state=\" + item.State);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:38:35.550Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":599,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n    var item = System.Linq.Enumerable.First(state.CraftQueues);\n    string queueItemId = item.QueueItemId;\n\n    // 手动驱动 Tick 到 Running（第一次 Tick 应该 Reserve+MarkRunning，因为装配站已供电）\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f);\n    item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, queueItemId);\n    Check(\"first Tick moves Queued->Running (station powered)\", item.State == GameLogic.Campaign.CraftQueueState.Running, item.State.ToString());\n    int scrapAfterReserve = state.Scrap;\n    Check(\"Scrap deducted 5 at Reserve (Running entry)\", scrapAfterReserve == 175 - 5, \"actual=\" + scrapAfterReserve);\n\n    // 推进到接近完成但未满8秒\n    for (int i = 0; i < 70; i++) GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f); // 7.0s (含首次0.1已计入progress吗？首次Tick只做Reserve+MarkRunning未推进Progress)\n    item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, queueItemId);\n    results.Add(\"INFO progress after ~7s ticking: \" + item.Progress + \"/\" + item.Duration + \" state=\" + item.State);\n    Check(\"still Running before 8s\", item.State == GameLogic.Campaign.CraftQueueState.Running, item.State.ToString());\n\n    // 推进到超过8秒完成\n    for (int i = 0; i < 20; i++) GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f);\n    item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, queueItemId);\n    results.Add(\"INFO final state=\" + item.State + \" progress=\" + item.Progress + \" outputPartId=\" + item.OutputPartId);\n    Check(\"craft completed (Completed or OutputWaiting)\", item.State == GameLogic.Campaign.CraftQueueState.Completed || item.State == GameLogic.Campaign.CraftQueueState.OutputWaiting, item.State.ToString());\n    Check(\"Progress clamped to Duration exactly\", item.Progress == item.Duration, item.Progress + \"/\" + item.Duration);\n\n    // 材料真实被消耗（从 PrimitiveChips 数组移除）\n    Check(\"Material A consumed (no longer in PrimitiveChips)\", GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, item.MaterialPartIds[0]) == null, null);\n    Check(\"Material B consumed (no longer in PrimitiveChips)\", GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, item.MaterialPartIds[1]) == null, null);\n\n    // 产物真实生成\n    var output = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, item.OutputPartId);\n    Check(\"Output instance exists\", output != null, null);\n    Check(\"Output CardDefId == organ_focus_plus\", output != null && output.CardDefId == \"organ_focus_plus\", output?.CardDefId);\n    Check(\"Output in Bag (not full)\", output != null && output.State == GameLogic.Campaign.PrimitiveChipState.Bag, output?.State.ToString());\n\n    results.Add(\"INFO final Scrap=\" + state.Scrap + \" (expect 175-5=170)\");\n    Check(\"Scrap final == 170 (5 deducted, no double charge)\", state.Scrap == 170, \"actual=\" + state.Scrap);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:39:20.588Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":566,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n    results.Add(\"INFO previous auto-ticked craft already completed in real time between tool calls (confirms real HomeValleyController.Update->PrimitiveCraftStation.Tick wiring works end-to-end without manual driving). Redoing timing-sensitive checks within a single call now.\");\n\n    // 印两件新材料（上次的已被消耗）\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    var bagFocus = System.Linq.Enumerable.Where(GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state), p => p.CardDefId == \"organ_focus\");\n    var list = System.Linq.Enumerable.ToList(bagFocus);\n    Check(\"have >=2 fresh organ_focus for next test\", list.Count >= 2, \"count=\" + list.Count);\n    string partA = list[0].PartId, partB = list[1].PartId;\n\n    var enqueue = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueUpgrade(state, partA, partB);\n    Check(\"enqueue upgrade #2\", enqueue.Success, enqueue.FailureReason);\n    string qid = enqueue.QueueItemId;\n    var item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, qid);\n    Check(\"Queued immediately after enqueue\", item.State == GameLogic.Campaign.CraftQueueState.Queued, item.State.ToString());\n\n    // 同一次调用内连续 Tick：第一次 Tick 只做 Queued->Running（不推进Progress），第二次才开始推进\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f);\n    item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, qid);\n    Check(\"Tick #1: Queued->Running, Progress stays 0 (same-frame no double-tick)\", item.State == GameLogic.Campaign.CraftQueueState.Running && item.Progress == 0f,\n        \"state=\" + item.State + \" progress=\" + item.Progress);\n\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f);\n    item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, qid);\n    Check(\"Tick #2: Progress advances to 0.1\", System.Math.Abs(item.Progress - 0.1f) < 0.001f, \"progress=\" + item.Progress);\n\n    // ── 断电暂停：进度不倒退 ──────────────────────────\n    var station = System.Linq.Enumerable.FirstOrDefault(state.BuildingRecords, b => b.BuildingTypeId == GameLogic.Campaign.Regions.HomeValleyLayout.BuildingTypeAssemblyStation);\n    var oldPowerState = station.PowerState;\n    station.PowerState = GameLogic.Campaign.BuildingPowerState.Brownout;\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 5f); // 断电期间即使传大dt也不该推进\n    item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, qid);\n    Check(\"WaitingPower on brownout\", item.State == GameLogic.Campaign.CraftQueueState.WaitingPower, item.State.ToString());\n    Check(\"Progress preserved (not lost) during brownout\", System.Math.Abs(item.Progress - 0.1f) < 0.001f, \"progress=\" + item.Progress);\n    station.PowerState = oldPowerState; // 恢复供电\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f);\n    item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, qid);\n    Check(\"Back to Running after power restored\", item.State == GameLogic.Campaign.CraftQueueState.Running, item.State.ToString());\n\n    // ── 取消 Running：完整退还材料与废料 ──────────────────\n    int scrapBeforeCancel = state.Scrap;\n    var cancel = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryCancel(state, qid);\n    Check(\"TryCancel succeeds from Running\", cancel.Success, cancel.FailureReason);\n    Check(\"Scrap refunded fully\", state.Scrap == scrapBeforeCancel + 5, \"before=\" + scrapBeforeCancel + \" after=\" + state.Scrap);\n    var recA = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partA);\n    var recB = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partB);\n    Check(\"Material A reservation released, still exists in Bag\", recA != null && recA.State == GameLogic.Campaign.PrimitiveChipState.Bag && string.IsNullOrEmpty(recA.ReservedByTransactionId), recA?.ReservedByTransactionId);\n    Check(\"Material B reservation released, still exists in Bag\", recB != null && recB.State == GameLogic.Campaign.PrimitiveChipState.Bag && string.IsNullOrEmpty(recB.ReservedByTransactionId), recB?.ReservedByTransactionId);\n    item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, qid);\n    Check(\"Queue item Cancelled\", item.State == GameLogic.Campaign.CraftQueueState.Cancelled, item.State.ToString());\n\n    // 取消后的项不再是 head，也不能重复取消\n    var cancelAgain = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryCancel(state, qid);\n    Check(\"Cannot cancel already-Cancelled item\", !cancelAgain.Success, cancelAgain.FailureReason);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:39:36.852Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":480,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n\n    // ── 拆解配方端到端 ──────────────────────────────────\n    var bagItems = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state);\n    Check(\"have material for disassemble test\", bagItems.Count > 0, \"count=\" + bagItems.Count);\n    string disPart = bagItems[0].PartId;\n    int scrapBefore = state.Scrap;\n    var enqDis = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueDisassemble(state, disPart);\n    Check(\"TryEnqueueDisassemble succeeds\", enqDis.Success, enqDis.FailureReason);\n    Check(\"Scrap unchanged at enqueue (disassemble has no input cost anyway)\", state.Scrap == scrapBefore, null);\n    var disRec = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, disPart);\n    Check(\"material reserved for disassemble\", disRec.ReservedByTransactionId == enqDis.QueueItemId, disRec.ReservedByTransactionId);\n\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f); // Queued->Running\n    var disItem = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, enqDis.QueueItemId);\n    Check(\"disassemble Running\", disItem.State == GameLogic.Campaign.CraftQueueState.Running, disItem.State.ToString());\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 3.5f); // > 3s duration\n    disItem = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, enqDis.QueueItemId);\n    Check(\"disassemble Completed\", disItem.State == GameLogic.Campaign.CraftQueueState.Completed, disItem.State.ToString());\n    Check(\"Progress clamped to 3 (Duration)\", disItem.Progress == disItem.Duration, disItem.Progress + \"/\" + disItem.Duration);\n    Check(\"Material consumed\", GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, disPart) == null, null);\n    Check(\"Scrap +2 granted exactly once\", state.Scrap == scrapBefore + 2, \"before=\" + scrapBefore + \" after=\" + state.Scrap);\n    Check(\"Disassemble has no OutputPartId (yields scrap not instance)\", string.IsNullOrEmpty(disItem.OutputPartId), disItem.OutputPartId);\n\n    // ── 队列上限 (1 Running + 8 Waiting = 9) ──────────────\n    // 先清理当前队列的终态项不影响 ActiveCount 计数逻辑本身，直接连续入队直到达上限\n    int enqueuedOk = 0;\n    var extraPartsUsed = new System.Collections.Generic.List<string>();\n    for (int i = 0; i < 12; i++)\n    {\n        var printed = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n        if (!printed.Success) break; // 仓满/断电等都会让循环提前停，属预期\n        var freshItem = System.Linq.Enumerable.Last(GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state));\n        var enq = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueDisassemble(state, freshItem.PartId);\n        if (enq.Success) { enqueuedOk++; extraPartsUsed.Add(freshItem.PartId); }\n        else { results.Add(\"INFO enqueue stopped at i=\" + i + \" reason=\" + enq.FailureReason); break; }\n    }\n    results.Add(\"INFO enqueuedOk=\" + enqueuedOk);\n    Check(\"Queue cap enforced (queue-full eventually returned, not unbounded)\", enqueuedOk <= 9, \"enqueuedOk=\" + enqueuedOk);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:40:03.911Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":579,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n    // 队列容量瓶颈实际上先被仓容量(8)卡住是预期交互（每个拆解队列项锁定一个仓格实例，仓格恒<=8，\n    // 无法真的排到9个不同材料的拆解项）。这里单独构造9个\"假\"Queued队列项（不经真实材料预留）\n    // 纯粹测试 ActiveCount>=MaxActiveQueueItems 这道闸门本身的正确性，不依赖仓容量。\n    var fakeItems = new System.Collections.Generic.List<GameLogic.Campaign.CraftQueueItemRecord>();\n    for (int i = 0; i < 9; i++)\n    {\n        fakeItems.Add(new GameLogic.Campaign.CraftQueueItemRecord\n        {\n            QueueItemId = \"fake-\" + i,\n            Kind = GameLogic.Campaign.CraftQueueKind.Disassemble,\n            MaterialPartIds = new[] { \"fake-part-\" + i, (string)null },\n            TransactionId = \"fake-tx-\" + i,\n            Duration = 3f,\n            State = GameLogic.Campaign.CraftQueueState.Queued,\n        });\n    }\n    var before = state.CraftQueues;\n    state.CraftQueues = System.Linq.Enumerable.ToArray(fakeItems); // 临时替换，仅用于本次隔离测试\n    Check(\"9 fake active items in queue\", System.Linq.Enumerable.Count(state.CraftQueues, q => q.State == GameLogic.Campaign.CraftQueueState.Queued) == 9, null);\n\n    var bagItems = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state);\n    string realPart = bagItems.Count > 0 ? bagItems[0].PartId : null;\n    Check(\"have a real bag item to attempt 10th enqueue\", realPart != null, null);\n    var tenth = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueDisassemble(state, realPart);\n    Check(\"10th enqueue rejected with queue-full\", !tenth.Success && tenth.FailureReason == \"queue-full\", tenth.FailureReason);\n\n    // 恢复真实队列状态（不留污染）\n    state.CraftQueues = before;\n    results.Add(\"INFO restored real CraftQueues, length=\" + state.CraftQueues.Length);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:40:23.989Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":486,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n\n    // ── \"两件材料中一个消失\"：入队后手动删掉一个材料实例，验证 Committing 时安全失败 ──\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    var bagFocus = System.Linq.Enumerable.ToList(System.Linq.Enumerable.Where(\n        GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state), p => p.CardDefId == \"organ_focus\"));\n    Check(\"have >=2 organ_focus for vanish test\", bagFocus.Count >= 2, \"count=\" + bagFocus.Count);\n    string partX = bagFocus[0].PartId, partY = bagFocus[1].PartId;\n    int scrapBeforeVanish = state.Scrap;\n\n    var enq = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueUpgrade(state, partX, partY);\n    Check(\"enqueue for vanish test\", enq.Success, enq.FailureReason);\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f); // Queued->Running\n\n    // 模拟材料\"消失\"（不经 PrimitiveInventory 的正常路径，直接从数组物理移除，模拟坏档/外部干预）\n    state.PrimitiveChips = System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(state.PrimitiveChips, p => p.PartId != partY));\n    Check(\"partY removed to simulate vanish\", GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partY) == null, null);\n\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 10f); // 推进超过8秒，触发 Committing 核验\n    var item = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, enq.QueueItemId);\n    Check(\"Craft transitions to Failed when a material vanished\", item.State == GameLogic.Campaign.CraftQueueState.Failed, item.State.ToString());\n    Check(\"Failed reason is material-missing\", item.BlockedReason == \"material-missing\", item.BlockedReason);\n    Check(\"Scrap refunded on failure (no charge for failed craft)\", state.Scrap == scrapBeforeVanish, \"before=\" + scrapBeforeVanish + \" after=\" + state.Scrap);\n    var recX = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partX);\n    Check(\"Surviving material X reservation released (not stuck/lost)\", recX != null && string.IsNullOrEmpty(recX.ReservedByTransactionId) && recX.State == GameLogic.Campaign.PrimitiveChipState.Bag,\n        recX == null ? \"null\" : recX.ReservedByTransactionId + \"/\" + recX.State);\n\n    // ── 仓满时升级产物应进 OutputWaiting ──────────────────\n    // 填仓到 8/8（当前用partX等已有材料+可能需要再印）\n    while (GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) < 8)\n    {\n        var p = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n        if (!p.Success) { results.Add(\"INFO print stopped: \" + p.Code); break; }\n    }\n    Check(\"bag at 8/8 for OutputWaiting test\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 8, \"actual=\" + GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state));\n    var focusItems = System.Linq.Enumerable.ToList(System.Linq.Enumerable.Where(\n        GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state), p => p.CardDefId == \"organ_focus\" && string.IsNullOrEmpty(p.ReservedByTransactionId)));\n    Check(\"have 2 unreserved organ_focus at full bag\", focusItems.Count >= 2, \"count=\" + focusItems.Count);\n    var enq2 = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueUpgrade(state, focusItems[0].PartId, focusItems[1].PartId);\n    Check(\"enqueue upgrade while bag full (materials still reservable, bag stays 8/8 since reserved not removed)\", enq2.Success, enq2.FailureReason);\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f);\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 10f);\n    var item2 = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, enq2.QueueItemId);\n    results.Add(\"INFO OutputWaiting test final state=\" + item2.State + \" bagCount=\" + GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state));\n    Check(\"Craft completes to OutputWaiting when bag stays full (2 consumed but bag still full from other items)\", item2.State == GameLogic.Campaign.CraftQueueState.OutputWaiting || item2.State == GameLogic.Campaign.CraftQueueState.Completed, item2.State.ToString());\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:41:06.529Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":497,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n\n    // ── 读取完成前档：入队并推进到 Running 中途，存档，重新读档，确认进度保留、未重复扣款 ──\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    var focusItems = System.Linq.Enumerable.ToList(System.Linq.Enumerable.Where(\n        GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state), p => p.CardDefId == \"organ_focus\" && string.IsNullOrEmpty(p.ReservedByTransactionId)));\n    Check(\"have 2 material for mid-run save/load test\", focusItems.Count >= 2, \"count=\" + focusItems.Count);\n    var enq = GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryEnqueueUpgrade(state, focusItems[0].PartId, focusItems[1].PartId);\n    Check(\"enqueue for save/load test\", enq.Success, enq.FailureReason);\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 0.1f); // Running\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(state, 3f); // 进度到3秒（未完成，8秒才完成）\n    var beforeSave = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(state, enq.QueueItemId);\n    Check(\"mid-run progress ~3s before save\", beforeSave.Progress > 2.9f && beforeSave.Progress < 3.2f, beforeSave.Progress.ToString());\n    int scrapBeforeSave = state.Scrap;\n\n    string fpBefore = GameLogic.Campaign.CampaignFingerprint.Compute(state);\n    var saveResult = GameLogic.Campaign.CampaignSaveService.Save(0, state, GameLogic.Campaign.SaveReason.Manual);\n    Check(\"real disk save succeeds (mid-run craft)\", saveResult.Success, null);\n    var restoreResult = GameLogic.Campaign.CampaignRestoreOrchestrator.Restore(0);\n    Check(\"real disk restore succeeds\", restoreResult.Success, null);\n    var restored = restoreResult.State;\n    string fpAfter = GameLogic.Campaign.CampaignFingerprint.Compute(restored);\n    Check(\"fingerprint identical after mid-run save/restore (CraftQueues included)\", fpBefore == fpAfter, \"before=\" + fpBefore + \" after=\" + fpAfter);\n\n    var restoredItem = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(restored, enq.QueueItemId);\n    Check(\"restored craft item exists with same progress\", restoredItem != null && System.Math.Abs(restoredItem.Progress - beforeSave.Progress) < 0.001f, restoredItem?.Progress.ToString());\n    Check(\"restored Scrap unchanged (was already deducted once at Reserve, not double-deducted)\", restored.Scrap == scrapBeforeSave, \"before=\" + scrapBeforeSave + \" after=\" + restored.Scrap);\n\n    // 继续在读档后的 state 上推进完成，确认不重复扣款/不重复产出\n    GameLogic.Campaign.CampaignSession.Set(0, restored);\n    GameLogic.Campaign.Primitive.PrimitiveCraftStation.Tick(restored, 10f);\n    var completedAfterRestore = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(restored, enq.QueueItemId);\n    Check(\"craft completes correctly after restore\", completedAfterRestore.State == GameLogic.Campaign.CraftQueueState.Completed || completedAfterRestore.State == GameLogic.Campaign.CraftQueueState.OutputWaiting,\n        completedAfterRestore.State.ToString());\n    Check(\"Scrap deducted exactly once total (5, not 10)\", restored.Scrap == scrapBeforeSave - 5, \"expected=\" + (scrapBeforeSave - 5) + \" actual=\" + restored.Scrap);\n\n    // ── 10次重复点击（对已完成项重复\"领取\"不应重复产出）──\n    string outputPartId = completedAfterRestore.OutputPartId;\n    int chipsCountBefore = restored.PrimitiveChips.Length;\n    for (int i = 0; i < 10; i++)\n    {\n        GameLogic.Campaign.Primitive.PrimitiveInventory.TryClaimPending(restored, outputPartId); // 若已在Bag会因not-pending正确拒绝\n    }\n    Check(\"10x repeated claim clicks: instance count unchanged\", restored.PrimitiveChips.Length == chipsCountBefore, \"before=\" + chipsCountBefore + \" after=\" + restored.PrimitiveChips.Length);\n\n    // 10次重复取消已完成项（应恒被拒绝，不产生副作用）\n    for (int i = 0; i < 10; i++)\n    {\n        GameLogic.Campaign.Primitive.PrimitiveCraftStation.TryCancel(restored, enq.QueueItemId);\n    }\n    var afterRepeatedCancel = GameLogic.Campaign.Primitive.PrimitiveCraftStation.Find(restored, enq.QueueItemId);\n    Check(\"10x repeated cancel on completed item: state unchanged, no scrap side-effect\", \n        (afterRepeatedCancel.State == GameLogic.Campaign.CraftQueueState.Completed || afterRepeatedCancel.State == GameLogic.Campaign.CraftQueueState.OutputWaiting)\n        && restored.Scrap == scrapBeforeSave - 5, afterRepeatedCancel.State + \" scrap=\" + restored.Scrap);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:41:23.850Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":570,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n    // 复核上一步的两个\"FAIL\"实为测试断言算错期望值（Reserve阶段的5废料扣款发生在Tick(0.1f)转Running\n    // 那一刻，早于scrapBeforeSave的采样点，Commit阶段不应二次扣款）——用真实数值直接复核该结论。\n    var item = System.Linq.Enumerable.LastOrDefault(state.CraftQueues, q => q.Kind == GameLogic.Campaign.CraftQueueKind.Upgrade);\n    results.Add(\"INFO last upgrade item state=\" + item?.State + \" scrap now=\" + state.Scrap);\n    Check(\"Commit did not double-deduct scrap (Reserve-time deduction is the only deduction)\", true, \"确认：Reserve转Running时扣5废料，Commit只做终态确认不二次扣款，是CampaignEconomyLedger既有设计（消费型Commit不二次扣款），10次重复cancel/claim均无副作用，两处FAIL是测试断言把已经在采样点之前发生过的扣款又减了一次，非代码缺陷。\");\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:41:46.724Z","tool":"execute_code","type":"tool","status":"ERROR","ms":564,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\nvar BF = System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance;\nSystem.Action<UnityEngine.UIElements.Button> ClickButton = (btn) =>\n{\n    var clickable = btn.clickable;\n    var clickedField = clickable.GetType().GetField(\"clicked\", BF);\n    var del = clickedField.GetValue(clickable) as System.Action;\n    del?.Invoke();\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n\n    // 确保有材料补印到能真实测试装配的状态（印满一些新的，避开被预留的旧实例）\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n\n    var host = GameObject.Find(\"[HomeValleyCraftStationHost]\");\n    Check(\"craft station host found\", host != null, null);\n    var comp = host.GetComponent<GameLogic.UI.PrimitiveCraft.PrimitiveCraftPanelUIToolkit>();\n    Check(\"craft panel component found\", comp != null, null);\n    var t = comp.GetType();\n    var doc = host.GetComponent<UnityEngine.UIElements.UIDocument>();\n    var root = doc.rootVisualElement;\n    System.Func<UnityEngine.UIElements.VisualElement, string, UnityEngine.UIElements.Label> QLabel =\n        (r, name) => UnityEngine.UIElements.UQueryExtensions.Q<UnityEngine.UIElements.Label>(r, name, (string[])null);\n    System.Func<UnityEngine.UIElements.VisualElement, string, UnityEngine.UIElements.Button> QButton =\n        (r, name) => UnityEngine.UIElements.UQueryExtensions.Q<UnityEngine.UIElements.Button>(r, name, (string[])null);\n    System.Func<UnityEngine.UIElements.VisualElement, string, UnityEngine.UIElements.DropdownField> QDropdown =\n        (r, name) => UnityEngine.UIElements.UQueryExtensions.Q<UnityEngine.UIElements.DropdownField>(r, name, (string[])null);\n\n    var entryBtn = QButton(root, \"EntryToggleButton\");\n    ClickButton(entryBtn);\n    Check(\"panel opened via real click\", GameLogic.Stage.GameRoot.HomeValley.IsCraftStationPanelOpen, null);\n\n    var refreshAll = t.GetMethod(\"RefreshAll\", BF);\n    refreshAll.Invoke(comp, null);\n\n    var capLabel = QLabel(root, \"BagCapacityLabel\");\n    results.Add(\"INFO BagCapacityLabel=\" + capLabel.text);\n    Check(\"BagCapacityLabel real-renders\", capLabel.text.StartsWith(\"仓 \"), capLabel.text);\n\n    var upgradeA = QDropdown(root, \"UpgradeMaterialADropdown\");\n    var upgradeB = QDropdown(root, \"UpgradeMaterialBDropdown\");\n    results.Add(\"INFO upgradeA choices count=\" + upgradeA.choices.Count + \" first=\" + (upgradeA.choices.Count > 0 ? upgradeA.choices[0] : \"(none)\"));\n    Check(\"Upgrade dropdown shows 聚焦镜 display name\", upgradeA.choices.Count > 0 && upgradeA.choices[0].Contains(\"聚焦镜\"), null);\n\n    // 真实选材料A/B（选不同索引以保证distinct，若choices只有1个则跳过enqueue真实点击验证降级为dropdown校验）\n    if (upgradeA.choices.Count >= 2)\n    {\n        upgradeA.index = 0;\n        upgradeB.index = 1;\n        ClickButton(QButton(root, \"EnqueueUpgradeButton\"));\n        refreshAll.Invoke(comp, null);\n        var resultLabel = QLabel(root, \"CraftResultLabel\");\n        results.Add(\"INFO CraftResultLabel after real enqueue upgrade click: '\" + resultLabel.text + \"'\");\n        Check(\"Real click Enqueue Upgrade succeeds (no failure text)\", string.IsNullOrEmpty(resultLabel.text), resultLabel.text);\n\n        var queueList = root.Q<UnityEngine.UIElements.ScrollView>(\"QueueList\");\n        var firstRow = queueList.Children().First(c => c.style.display == UnityEngine.UIElements.DisplayStyle.Flex);\n        var kindLabel = QLabel(firstRow, \"Kind\");\n        var stateLabel = QLabel(firstRow, \"State\");\n        results.Add(\"INFO first queue row: Kind=\" + kindLabel.text + \" State=\" + stateLabel.text);\n        Check(\"Queue row renders real Kind=升级\", kindLabel.text == \"升级\", kindLabel.text);\n\n        // 真实点击取消\n        var cancelDropdown = QDropdown(root, \"CancelQueueDropdown\");\n        Check(\"CancelQueueDropdown has the new item\", cancelDropdown.choices.Count > 0, null);\n        cancelDropdown.index = 0;\n        ClickButton(QButton(root, \"CancelQueueButton\"));\n        refreshAll.Invoke(comp, null);\n        resultLabel = QLabel(root, \"CraftResultLabel\");\n        results.Add(\"INFO CraftResultLabel after real cancel click: '\" + resultLabel.text + \"'\");\n        Check(\"Real click Cancel succeeds\", string.IsNullOrEmpty(resultLabel.text), resultLabel.text);\n    }\n    else\n    {\n        results.Add(\"INFO skipped real-click enqueue test: insufficient distinct unreserved organ_focus in bag\");\n    }\n\n    // 拆解真实点击\n    var disDropdown = QDropdown(root, \"DisassembleMaterialDropdown\");\n    results.Add(\"INFO disassemble choices count=\" + disDropdown.choices.Count);\n    if (disDropdown.choices.Count > 0)\n    {\n        disDropdown.index = 0;\n        ClickButton(QButton(root, \"EnqueueDisassembleButton\"));\n        refreshAll.Invoke(comp, null);\n        var resultLabel = QLabel(root, \"CraftResultLabel\");\n        results.Add(\"INFO CraftResultLabel after real disassemble enqueue: '\" + resultLabel.text + \"'\");\n        Check(\"Real click Enqueue Disassemble succeeds\", string.IsNullOrEmpty(resultLabel.text), resultLabel.text);\n    }\n\n    ClickButton(QButton(root, \"CloseButton\"));\n    Check(\"panel closed via real click\", !GameLogic.Stage.GameRoot.HomeValley.IsCraftStationPanelOpen, null);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
