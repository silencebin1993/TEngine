{"ts":"2026-09-23T02:24:52.323Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1229,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    string campaignId = System.Guid.NewGuid().ToString(\"N\");\n    int seed = GameLogic.Campaign.CampaignRandomService.GenerateSeed();\n    var state = GameLogic.Campaign.CampaignState.CreateNew(campaignId, \"Standard\", seed);\n    GameLogic.Campaign.CampaignSaveService.Save(0, state, GameLogic.Campaign.SaveReason.NewCampaign);\n    GameLogic.Campaign.MachineRegistry.ResetForNewCampaign();\n    GameLogic.Campaign.CampaignSession.Set(0, state);\n    GameApp.MountGameplayUi();\n    GameLogic.Stage.GameRoot.StartHomeValley();\n    state = GameLogic.Campaign.CampaignSession.Current;\n    Check(\"fresh campaign, HomeValley active\", GameLogic.Stage.GameRoot.HomeValley.IsActive, null);\n    Check(\"seeded 1 chip\", state.PrimitiveChips.Length == 1, null);\n\n    var generator = System.Linq.Enumerable.FirstOrDefault(state.BuildingRecords, b => b.BuildingTypeId == \"generator\");\n    generator.ConstructionState = GameLogic.Campaign.BuildingConstructionState.Operational;\n    GameLogic.Campaign.Regions.HomeValleyPowerGrid.Recompute(state);\n\n    // 印满到8\n    while (GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) < 8)\n        GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    Check(\"bag filled to 8\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 8, null);\n\n    var board = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n        GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, \"comp_gun\", null, null, System.Array.Empty<string>());\n\n    // 装一个进电路（腾出仓位到7/8），然后印回满8/8\n    string firstBagPart = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state)[0].PartId;\n    var eq = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 2, firstBagPart);\n    Check(\"equip one to free a bag slot (7/8)\", eq.Success && GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 7, null);\n    var printBack = GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\"); // 补回到 8/8（供电已修好）\n    Check(\"bag refilled to exactly 8 again\", printBack.Success && GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 8, null);\n\n    // ── 核心修复验证：仓满(8/8)时卸下应拒绝，原槽保留 ──────\n    var unequipWhenFull = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToBag(state, board, 2);\n    Check(\"TryMoveToBag rejects when bag is exactly full (AC-PRM-006 fix)\", !unequipWhenFull.Success, unequipWhenFull.Code + \":\" + unequipWhenFull.Message);\n    Check(\"bag-full is the failure code\", unequipWhenFull.Code == \"bag-full\", unequipWhenFull.Code);\n    Check(\"original slot preserved: board still has content at slot2\", board.SlotContentIds[2] == \"organ_focus\", board.SlotContentIds[2]);\n    Check(\"original slot preserved: board SlotPartIds[2] unchanged\", board.SlotPartIds[2] == firstBagPart, board.SlotPartIds[2]);\n    var recStillDraft = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, firstBagPart);\n    Check(\"instance record still Draft (not silently moved)\", recStillDraft.State == GameLogic.Campaign.PrimitiveChipState.Draft, recStillDraft.State.ToString());\n    Check(\"bag count unchanged at 8 after rejected unequip\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 8, null);\n\n    // 腾出一格后，卸下应成功\n    var claimHelper = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state)[0].PartId;\n    var eq2 = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 4, claimHelper); // 7/8\n    Check(\"free a slot again (7/8)\", eq2.Success, null);\n    var unequipNowOk = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToBag(state, board, 2); // 应成功，回到8/8\n    Check(\"TryMoveToBag succeeds once bag has room (7->8)\", unequipNowOk.Success, unequipNowOk.Message);\n    Check(\"board slot2 cleared after successful unequip\", string.IsNullOrEmpty(board.SlotContentIds[2]), board.SlotContentIds[2]);\n\n    results.Add(\"INFO final BagCount=\" + GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state));\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:25:10.251Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":581,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\nvar BF = System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance;\nSystem.Action<UnityEngine.UIElements.Button> ClickButton = (btn) =>\n{\n    var clickable = btn.clickable;\n    var clickedField = clickable.GetType().GetField(\"clicked\", BF);\n    var del = clickedField.GetValue(clickable) as System.Action;\n    del?.Invoke();\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n    // 印回到 8/8（上一步测试结束后是 8/8）\n    Check(\"precondition: bag at 8/8\", GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state) == 8, \"actual=\" + GameLogic.Campaign.Primitive.PrimitiveInventory.BagCount(state));\n\n    var host = GameObject.Find(\"[HomeValleyCircuitBoardHost]\");\n    var comp = host.GetComponent<GameLogic.UI.CircuitBoard.CircuitBoardPanelUIToolkit>();\n    var t = comp.GetType();\n    var doc = host.GetComponent<UnityEngine.UIElements.UIDocument>();\n    var root = doc.rootVisualElement;\n    System.Func<UnityEngine.UIElements.VisualElement, string, UnityEngine.UIElements.Label> QLabel =\n        (r, name) => UnityEngine.UIElements.UQueryExtensions.Q<UnityEngine.UIElements.Label>(r, name, (string[])null);\n    System.Func<UnityEngine.UIElements.VisualElement, string, UnityEngine.UIElements.Button> QButton =\n        (r, name) => UnityEngine.UIElements.UQueryExtensions.Q<UnityEngine.UIElements.Button>(r, name, (string[])null);\n    System.Func<UnityEngine.UIElements.VisualElement, string, UnityEngine.UIElements.DropdownField> QDropdown =\n        (r, name) => UnityEngine.UIElements.UQueryExtensions.Q<UnityEngine.UIElements.DropdownField>(r, name, (string[])null);\n\n    var setPanelOpen = t.GetMethod(\"SetPanelOpen\", BF);\n    var refreshAll = t.GetMethod(\"RefreshAll\", BF);\n    var selectSlot = t.GetMethod(\"SelectSlot\", BF);\n    setPanelOpen.Invoke(comp, new object[] { true });\n\n    // 面板默认懒加载 bp_erc003，先装一个进2号槽腾出空间，再印回满仓，制造\"仓满+槽2有装备\"场景\n    var board = (GameLogic.Campaign.Blueprint.BlueprintCircuitBoard)t.GetField(\"_board\", BF).GetValue(comp);\n    selectSlot.Invoke(comp, new object[] { 2 });\n    refreshAll.Invoke(comp, null);\n    var bagDropdown = QDropdown(root, \"BagChipDropdown\");\n    bagDropdown.index = 0;\n    ClickButton(QButton(root, \"EquipChipButton\"));\n    refreshAll.Invoke(comp, null);\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\"); // 补回满仓 8/8\n    refreshAll.Invoke(comp, null);\n    var capLabel = QLabel(root, \"BagCapacityLabel\");\n    results.Add(\"INFO cap before real unequip-while-full click: \" + capLabel.text);\n\n    selectSlot.Invoke(comp, new object[] { 2 });\n    ClickButton(QButton(root, \"RemoveChipButton\"));\n    refreshAll.Invoke(comp, null);\n    var bagResultLabel = QLabel(root, \"BagResultLabel\");\n    var slot2Button = QButton(root, \"Slot2\");\n    results.Add(\"INFO BagResultLabel after real remove click while full: \" + bagResultLabel.text);\n    results.Add(\"INFO Slot2 text (should still show chip): \" + slot2Button.text);\n    Check(\"Real UI click Remove while bag full shows real bag-full rejection\", bagResultLabel.text.Contains(\"bag-full\"), bagResultLabel.text);\n    Check(\"Slot2 still shows 聚焦镜 (not silently emptied)\", slot2Button.text.Contains(\"聚焦镜\"), slot2Button.text);\n\n    ClickButton(QButton(root, \"CloseButton\"));\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
