{"ts":"2026-09-23T02:17:14.418Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1239,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    string campaignId = System.Guid.NewGuid().ToString(\"N\");\n    int seed = GameLogic.Campaign.CampaignRandomService.GenerateSeed();\n    var state = GameLogic.Campaign.CampaignState.CreateNew(campaignId, \"Standard\", seed);\n    GameLogic.Campaign.CampaignSaveService.Save(0, state, GameLogic.Campaign.SaveReason.NewCampaign);\n    GameLogic.Campaign.MachineRegistry.ResetForNewCampaign();\n    GameLogic.Campaign.CampaignSession.Set(0, state);\n    GameApp.MountGameplayUi();\n    GameLogic.Stage.GameRoot.StartHomeValley();\n    state = GameLogic.Campaign.CampaignSession.Current;\n    Check(\"HomeValley entered\", GameLogic.Stage.GameRoot.HomeValley.IsActive, null);\n    Check(\"Seeded 1 chip on entry\", state.PrimitiveChips.Length == 1, \"actual=\" + state.PrimitiveChips.Length);\n\n    // 供电装配站（后续多处测试需要）\n    var generator = System.Linq.Enumerable.FirstOrDefault(state.BuildingRecords, b => b.BuildingTypeId == \"generator\");\n    generator.ConstructionState = GameLogic.Campaign.BuildingConstructionState.Operational;\n    GameLogic.Campaign.Regions.HomeValleyPowerGrid.Recompute(state);\n\n    // ── 已占用槽位拒绝（修复验证）──────────────────────────\n    var board = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n        GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, \"comp_gun\", null, null, System.Array.Empty<string>());\n    var partA = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state)[0].PartId;\n    var eqA = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 3, partA);\n    Check(\"setup equip partA slot3\", eqA.Success, eqA.Message);\n    // 印一个新的塞进同一已占用槽位\n    GameLogic.Campaign.Primitive.PrimitiveInventory.TryPrintChip(state, \"organ_focus\");\n    var partB = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state)[0].PartId;\n    var eqBOccupied = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 3, partB);\n    Check(\"TryMoveToDraft now rejects occupied slot (bug fixed)\", !eqBOccupied.Success, eqBOccupied.Code);\n    var recB = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partB);\n    Check(\"partB stayed in Bag after rejected occupied-slot move\", recB.State == GameLogic.Campaign.PrimitiveChipState.Bag, recB.State.ToString());\n    var recA = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partA);\n    Check(\"partA (original occupant) still Draft/slot3 unaffected\", recA.State == GameLogic.Campaign.PrimitiveChipState.Draft && recA.DraftSlot == 3, recA.State + \"/\" + recA.DraftSlot);\n    Check(\"board slot3 content unchanged (still organ_focus from partA)\", board.SlotContentIds[3] == \"organ_focus\" && board.SlotPartIds[3] == partA, board.SlotPartIds[3]);\n\n    // ── 签名与实例无关（同内容不同实例签名相同）──────────────\n    string sig1 = board.ComputeSignature();\n    var unequip = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToBag(state, board, 3);\n    Check(\"unequip partA for signature test\", unequip.Success, unequip.Message);\n    var eqBNow = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 3, partB);\n    Check(\"equip partB (different instance, same content) into slot3\", eqBNow.Success, eqBNow.Message);\n    string sig2 = board.ComputeSignature();\n    Check(\"Signature identical across different instance same content\", sig1 == sig2, \"sig1=\" + sig1 + \" sig2=\" + sig2);\n\n    // ── ReconcileBlueprintDrafts：未保存切换应释放，已保存应保留 ──\n    var savedVersionBefore = board.ToVersion(1, state.PlaySeconds); // 模拟\"从未保存过\"（不写回state）\n    GameLogic.Campaign.Primitive.PrimitiveInventory.ReconcileBlueprintDrafts(state, \"bp_erc003\", null); // savedSlotPartIds=null 模拟蓝图从未真正保存过\n    var recBAfterReconcileNull = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partB);\n    Check(\"Reconcile with null saved releases unsaved Draft back to Bag\", recBAfterReconcileNull.State == GameLogic.Campaign.PrimitiveChipState.Bag, recBAfterReconcileNull.State.ToString());\n\n    // 重新装回，这次模拟\"已保存\"场景：savedSlotPartIds 包含 partB 在 slot3\n    var eqBAgain = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 3, partB);\n    Check(\"re-equip partB slot3\", eqBAgain.Success, eqBAgain.Message);\n    var savedSlotPartIds = (string[])board.SlotPartIds.Clone();\n    GameLogic.Campaign.Primitive.PrimitiveInventory.ReconcileBlueprintDrafts(state, \"bp_erc003\", savedSlotPartIds);\n    var recBAfterReconcileSaved = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partB);\n    Check(\"Reconcile keeps Draft when instance IS in saved slot set\", recBAfterReconcileSaved.State == GameLogic.Campaign.PrimitiveChipState.Draft, recBAfterReconcileSaved.State.ToString());\n\n    results.Add(\"INFO all mid-battery checks done. total PrimitiveChips=\" + state.PrimitiveChips.Length);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T02:17:39.670Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":463,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\ntry\n{\n    var state = GameLogic.Campaign.CampaignSession.Current;\n\n    // 从真实 CampaignState 的 bp_erc003 记录取活跃版本，重建一块与 UI SelectBlueprint 完全一致路径的板\n    var record = System.Linq.Enumerable.FirstOrDefault(state.BlueprintRecords, r => r.BlueprintId == \"bp_erc003\");\n    var activeVersion = System.Linq.Enumerable.FirstOrDefault(record.Versions, v => v.Version == record.ActiveVersion);\n    var board = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.FromVersion(activeVersion);\n    Check(\"fresh board slot3 empty (nothing saved there before)\", string.IsNullOrEmpty(board.SlotContentIds[3]), board.SlotContentIds[3]);\n\n    string partId = GameLogic.Campaign.Primitive.PrimitiveInventory.BagItems(state)[0].PartId;\n    var eq = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 3, partId);\n    Check(\"equip partId into fresh board slot3\", eq.Success, eq.Message);\n\n    // 未保存场景：Reconcile 用 savedSlotPartIds=旧存档的（不含 partId），应释放回仓\n    GameLogic.Campaign.Primitive.PrimitiveInventory.ReconcileBlueprintDrafts(state, \"bp_erc003\", activeVersion.CircuitSlotPartIds);\n    var recAfterUnsavedReconcile = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partId);\n    Check(\"Reconcile releases unsaved draft (not in old saved version)\", recAfterUnsavedReconcile.State == GameLogic.Campaign.PrimitiveChipState.Bag, recAfterUnsavedReconcile.State.ToString());\n\n    // 真实保存场景：重新装上，真正 ToVersion 写回 state.BlueprintRecords（模拟 OnSaveClicked）\n    var eq2 = GameLogic.Campaign.Primitive.PrimitiveInventory.TryMoveToDraft(state, board, \"bp_erc003\", 3, partId);\n    Check(\"re-equip on fresh board (should succeed, slot3 empty again after release)\", eq2.Success, eq2.Message);\n    int nextVer = record.Versions.Length + 1;\n    var newVersion = board.ToVersion(nextVer, state.PlaySeconds);\n    record.Versions = System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Append(record.Versions, newVersion));\n    record.ActiveVersion = nextVer;\n    Check(\"saved version CircuitSlotPartIds[3] == partId\", newVersion.CircuitSlotPartIds[3] == partId, newVersion.CircuitSlotPartIds[3]);\n\n    // 现在 Reconcile 用真实已保存的 CircuitSlotPartIds，应该保留 Draft（不误伤真实保存的装备）\n    GameLogic.Campaign.Primitive.PrimitiveInventory.ReconcileBlueprintDrafts(state, \"bp_erc003\", newVersion.CircuitSlotPartIds);\n    var recAfterSavedReconcile = GameLogic.Campaign.Primitive.PrimitiveInventory.Find(state, partId);\n    Check(\"Reconcile keeps Draft when instance IS in real saved CircuitSlotPartIds\", recAfterSavedReconcile.State == GameLogic.Campaign.PrimitiveChipState.Draft, recAfterSavedReconcile.State.ToString());\n\n    // 重新从存档重建板（模拟真实\"切走再切回\"），应该看到 partId 仍在 slot3\n    var reloadedBoard = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.FromVersion(newVersion);\n    Check(\"Reloaded board from saved version shows partId at slot3\", reloadedBoard.SlotPartIds[3] == partId, reloadedBoard.SlotPartIds[3]);\n    Check(\"Reloaded board content matches too\", reloadedBoard.SlotContentIds[3] == \"organ_focus\", reloadedBoard.SlotContentIds[3]);\n\n    results.Add(\"INFO done. total PrimitiveChips=\" + state.PrimitiveChips.Length);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
