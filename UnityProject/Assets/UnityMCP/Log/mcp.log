4, \"organ_focus_plus\");\n        b1.TryAddEdge(1, 4);\n        b1.TryAddEdge(4, 7);\n\n        var b2 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n            GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n            GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n            new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId });\n        b2.TryPlaceChip(4, \"organ_focus_plus\");\n        b2.TryPlaceChip(1, \"organ_focus\");\n        b2.TryAddEdge(4, 7);\n        b2.TryAddEdge(1, 4);\n\n        sig1 = b1.ComputeSignature();\n        string sig2 = b2.ComputeSignature();\n        Check(\"Signature equal for same content, different edge-add order\", sig1 == sig2, \"sig1=\" + sig1 + \" sig2=\" + sig2);\n\n        var b3 = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n            GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n            GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n            new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId });\n        b3.TryPlaceChip(1, \"organ_focus\");\n        b3.TryAddEdge(1, 4);\n        sig3 = b3.ComputeSignature();\n        Check(\"Signature differs when content differs\", sig1 != sig3, \"sig1=\" + sig1 + \" sig3=\" + sig3);\n    }\n\n    // ── JsonUtility 真实序列化 ──────────────────────────\n    {\n        var b = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n            GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n            GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n            new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId });\n        b.TryPlaceChip(1, \"organ_focus\");\n        b.TryPlaceChip(4, \"organ_focus_plus\");\n        b.TryAddEdge(1, 4);\n        var version = b.ToVersion(1, 10f);\n        string json = UnityEngine.JsonUtility.ToJson(version);\n        results.Add(\"RAW_JSON :: \" + json);\n        var restored = UnityEngine.JsonUtility.FromJson<GameLogic.Campaign.BlueprintVersionRecord>(json);\n        Check(\"Restored CircuitSlotContentIds length == 9\", restored.CircuitSlotContentIds != null && restored.CircuitSlotContentIds.Length == 9,\n            \"actual=\" + (restored.CircuitSlotContentIds == null ? \"null\" : restored.CircuitSlotContentIds.Length.ToString()));\n        Check(\"Restored CircuitSlotTypes length == 9\", restored.CircuitSlotTypes != null && restored.CircuitSlotTypes.Length == 9,\n            \"actual=\" + (restored.CircuitSlotTypes == null ? \"null\" : restored.CircuitSlotTypes.Length.ToString()));\n        Check(\"Restored CircuitEdges length == 1\", restored.CircuitEdges != null && restored.CircuitEdges.Length == 1,\n            \"actual=\" + (restored.CircuitEdges == null ? \"null\" : restored.CircuitEdges.Length.ToString()));\n        // 空槽（如2,3,5,6,7未装）原本是 null，JsonUtility 落盘/读回会变 \"\"，FromVersion 应把它规整回 null\n        var boardBack = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.FromVersion(restored);\n        Check(\"FromVersion regularizes empty slot '' back to null (slot2)\", boardBack.SlotContentIds[2] == null,\n            \"actual=\" + (boardBack.SlotContentIds[2] == null ? \"null\" : \"'\" + boardBack.SlotContentIds[2] + \"'\"));\n        string sigAfterRoundtrip = boardBack.ComputeSignature();\n        string sigBefore = b.ComputeSignature();\n        Check(\"Signature stable after 1x JsonUtility round trip\", sigAfterRoundtrip == sigBefore,\n            \"before=\" + sigBefore + \" after=\" + sigAfterRoundtrip);\n    }\n\n    // ── 20 次存读档往返 ──────────────────────────────────\n    {\n        var b = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.CreateDefault(\n            GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId, GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n            GameLogic.Campaign.Content.ComponentCatalog.FuncDashId, null,\n            new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId });\n        b.TryPlaceChip(1, \"organ_focus\");\n        b.TryPlaceChip(4, \"organ_focus_plus\");\n        b.TryAddEdge(1, 4);\n        b.TryAddEdge(4, 7);\n        string firstSig = b.ComputeSignature();\n        string firstJson = null;\n        var current = b;\n        bool allStable = true;\n        var mismatches = new System.Collections.Generic.List<string>();\n        for (int i = 0; i < 20; i++)\n        {\n            var ver = current.ToVersion(1, 5f);\n            string json = UnityEngine.JsonUtility.ToJson(ver);\n            if (i == 0) firstJson = json;\n            var restoredVer = UnityEngine.JsonUtility.FromJson<GameLogic.Campaign.BlueprintVersionRecord>(json);\n            current = GameLogic.Campaign.Blueprint.BlueprintCircuitBoard.FromVersion(restoredVer);\n            string sig = current.ComputeSignature();\n            if (sig != firstSig) { allStable = false; mismatches.Add(\"iter\" + i + \":\" + sig); }\n        }\n        Check(\"20x save/load round trip keeps stable signature\", allStable, string.Join(\" | \", mismatches));\n    }\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION_PART2: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-09-23T01:55:30.013Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":560,"action":"execute","params":{"action":"execute","code":"\nvar results = new System.Collections.Generic.List<string>();\nSystem.Action<string, bool, string> Check = (name, cond, detail) =>\n{\n    results.Add((cond ? \"PASS \" : \"FAIL \") + name + (detail != null ? \" :: \" + detail : \"\"));\n};\n\ntry\n{\n    var state = GameLogic.Campaign.CampaignState.CreateNew(\"mig-test-campaign\", \"Standard\", 42);\n    // 模拟旧 schema：一条已存在的 ERC-003 蓝图记录，Version=3，缺电路字段（CircuitSlotContentIds==null）\n    var oldVersion = new GameLogic.Campaign.BlueprintVersionRecord\n    {\n        Version = 3,\n        ChassisId = GameLogic.Campaign.Regions.HomeValleyLayout.Erc003ChassisId,\n        PrimaryId = GameLogic.Campaign.Content.ComponentCatalog.CompGunId,\n        UtilityId = GameLogic.Campaign.Content.ComponentCatalog.FuncDashId,\n        StructureId = null,\n        OrderedFirmwareIds = new[] { GameLogic.Campaign.Content.FirmwareCatalog.FwHomingId, GameLogic.Campaign.Content.FirmwareCatalog.FwTrailId },\n        ScrapCost = 999, // 旧字面值，迁移后应被真实重算覆盖\n        CreatedAtPlaySeconds = 77.5f,\n        CircuitSlotContentIds = null,\n        CircuitSlotTypes = null,\n        CircuitEdges = null,\n    };\n    var oldRecord = new GameLogic.Campaign.BlueprintRecord\n    {\n        BlueprintId = GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc003Id,\n        DisplayName = \"战斗履带 ERC-003\",\n        ActiveVersion = 3,\n        Archived = false,\n        Versions = new[] { oldVersion },\n    };\n    state.BlueprintRecords = new[] { oldRecord };\n\n    GameLogic.Campaign.Blueprint.BlueprintCircuitDefaults.EnsureCircuitDataSeeded(state);\n\n    // ERC-001 应被补一条默认蓝图\n    bool hasErc001 = false;\n    foreach (var r in state.BlueprintRecords) if (r.BlueprintId == GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc001Id) hasErc001 = true;\n    Check(\"EnsureCircuitDataSeeded adds missing ERC-001 default blueprint\", hasErc001, null);\n\n    // 旧 ERC-003 记录应被迁移：Version/CreatedAtPlaySeconds 保留，CircuitSlotContentIds 补齐\n    GameLogic.Campaign.BlueprintVersionRecord migrated = null;\n    foreach (var r in state.BlueprintRecords)\n    {\n        if (r.BlueprintId == GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc003Id)\n        {\n            foreach (var v in r.Versions) if (v.Version == 3) migrated = v;\n        }\n    }\n    Check(\"Migrated ERC-003 version found (Version preserved == 3)\", migrated != null, null);\n    if (migrated != null)\n    {\n        Check(\"Migrated CreatedAtPlaySeconds preserved == 77.5\", System.Math.Abs(migrated.CreatedAtPlaySeconds - 77.5f) < 0.001f, \"actual=\" + migrated.CreatedAtPlaySeconds);\n        Check(\"Migrated CircuitSlotContentIds length == 9\", migrated.CircuitSlotContentIds != null && migrated.CircuitSlotContentIds.Length == 9,\n            \"actual=\" + (migrated.CircuitSlotContentIds == null ? \"null\" : migrated.CircuitSlotContentIds.Length.ToString()));\n        Check(\"Migrated ScrapCost recalculated (not literal 999)\", migrated.ScrapCost != 999, \"actual=\" + migrated.ScrapCost);\n        Check(\"Migrated ScrapCost == 60 (matches FactoryProduceDefaults)\", migrated.ScrapCost == 60, \"actual=\" + migrated.ScrapCost);\n    }\n\n    // 幂等性：再跑一次，结果字节级/字段级完全一致\n    string sigBefore = migrated != null ? migrated.CompileSignature : null;\n    int versionCountBefore = state.BlueprintRecords.Length;\n    GameLogic.Campaign.Blueprint.BlueprintCircuitDefaults.EnsureCircuitDataSeeded(state);\n    Check(\"Idempotent: BlueprintRecords count unchanged after 2nd call\", state.BlueprintRecords.Length == versionCountBefore,\n        \"before=\" + versionCountBefore + \" after=\" + state.BlueprintRecords.Length);\n    GameLogic.Campaign.BlueprintVersionRecord migrated2 = null;\n    foreach (var r in state.BlueprintRecords)\n        if (r.BlueprintId == GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc003Id)\n            foreach (var v in r.Versions) if (v.Version == 3) migrated2 = v;\n    Check(\"Idempotent: CompileSignature unchanged after 2nd call\", migrated2 != null && migrated2.CompileSignature == sigBefore,\n        \"before=\" + sigBefore + \" after=\" + (migrated2 == null ? \"null\" : migrated2.CompileSignature));\n\n    // ERC-003 工厂三条蓝图合计 ScrapCost 精确等于 60/35/55 (第3节声称但未实测的算术核对)\n    var seededState = GameLogic.Campaign.CampaignState.CreateNew(\"scrapcost-check\", \"Standard\", 1);\n    // 手工构造与 HomeValleyFactory.EnsureBlueprintsSeeded 等价的三条骨架蓝图(无电路数据)，走迁移路径生成真实默认板\n    var skeletons = new System.Collections.Generic.List<GameLogic.Campaign.BlueprintRecord>();\n    string[] ids = { GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintErc003Id, GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintHaulerId, GameLogic.Campaign.Regions.HomeValleyLayout.BlueprintHoverId };\n    foreach (var id in ids)\n    {\n        skeletons.Add(new GameLogic.Campaign.BlueprintRecord\n        {\n            BlueprintId = id,\n            DisplayName = id,\n            ActiveVersion = 1,\n            Versions = new[] { new GameLogic.Campaign.BlueprintVersionRecord { Version = 1, CircuitSlotContentIds = null, CircuitSlotTypes = null, CircuitEdges = null } },\n        });\n    }\n    seededState.BlueprintRecords = skeletons.ToArray();\n    GameLogic.Campaign.Blueprint.BlueprintCircuitDefaults.EnsureCircuitDataSeeded(seededState);\n    int total = 0;\n    var perBp = new System.Collections.Generic.List<string>();\n    foreach (var r in seededState.BlueprintRecords)\n    {\n        int cost = r.Versions[0].ScrapCost;\n        total += cost;\n        perBp.Add(r.BlueprintId + \"=\" + cost);\n    }\n    Check(\"ERC-003+Hauler+Hover ScrapCost sum == 60+35+55=150\", total == 150, string.Join(\",\", perBp) + \" sum=\" + total);\n}\ncatch (System.Exception ex) { results.Add(\"EXCEPTION: \" + ex); }\nreturn string.Join(\"\\n\", results);\n","safety_checks":true,"compiler":"auto"}}
