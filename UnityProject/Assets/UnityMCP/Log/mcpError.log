ngine.UIElements.DropdownField> QDropdown =\n        (r, name) => UnityEngine.UIElements.UQueryExtensions.Q<UnityEngine.UIElements.DropdownField>(r, name, (string[])null);\n\n    var entryBtn = QButton(root, \"EntryToggleButton\");\n    ClickButton(entryBtn);\n    Check(\"panel opened via real click\", GameLogic.Stage.GameRoot.HomeValley.IsCraftStationPanelOpen, null);\n\n    var refreshAll = t.GetMethod(\"RefreshAll\", BF);\n    refreshAll.Invoke(comp, null);\n\n    var capLabel = QLabel(root, \"BagCapacityLabel\");\n    results.Add(\"INFO BagCapacityLabel=\" + capLabel.text);\n    Check(\"BagCapacityLabel real-renders\", capLabel.text.StartsWith(\"仓 \"), capLabel.text);\n\n    var upgradeA = QDropdown(root, \"UpgradeMaterialADropdown\");\n    var upgradeB = QDropdown(root, \"UpgradeMaterialBDropdown\");\n    results.Add(\"INFO upgradeA choices count=\" + upgradeA.choices.Count + \" first=\" + (upgradeA.choices.Count > 0 ? upgradeA.choices[0] : \"(none)\"));\n    Check(\"Upgrade dropdown shows 聚焦镜 display name\", upgradeA.choices.Count > 0 && upgradeA.choices[0].Contains(\"聚焦镜\"), null);\n\n    // 真实选材料A/B（选不同索引以保证distinct，若choices只有1个则跳过enqueue真实点击验证降级为dropdown校验）\n    if (upgradeA.choices.Count >= 2)\n    {\n        upgradeA.index = 0;\n        upgradeB.index = 1;\n        ClickButton(QButton(root, \"EnqueueUpgradeButton\"));\n        refreshAll.Invoke(comp, null);\n        var resultLabel = QLabel(root, \"CraftResultLabel\");\n        results.Add(\"INFO CraftResultLabel after real enqueue upgrade click: '\" + resultLabel.text + \"'\");\n        Check(\"Real click Enqueue Upgrade succeeds (no failure text)\", string.IsNullOrEmpty(resultLabel.text), resultLabel.text);\n\n        var queueList = root.Q<UnityEngine.UIElements.ScrollView>(\"QueueList\");\n        var firstRow = queueList.Children().First(c => c.style.display == UnityEngine.UIElements.DisplayStyle.Flex);\n        var kindLabel = QLabel(firstRow, \"Kind\");\n        var stateLabel = QLabel(firstRow, \"